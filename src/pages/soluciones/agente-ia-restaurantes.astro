---
import Layout from '../../layouts/Layout.astro';
import DemoModal from '../../components/DemoModal.astro';
---

<Layout
  title="Agente de IA para Restaurantes, Bares y Gastronomía | MM SmartInbox"
  description="IA que atiende a tus clientes y ordena la operación del restaurante. Automatiza reservas, pedidos, menú, eventos y seguimiento post-visita conectado a tu POS y WhatsApp."
>
  <div class="restaurant-page">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 1. HERO / BANNER -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="hero-section" id="hero">
      <div class="hero-container">
        
        <!-- Columna Izquierda: Texto y CTA -->
        <div class="hero-text-col" data-aos="fade-right">
          <div class="hero-badge">
            <span class="badge-pulse"></span>
            <span>Agente de IA para Restaurantes, Bares, Cafeterías y Cadenas</span>
          </div>

          <h1 class="hero-title">
            IA que atiende a tus clientes y ordena la operación del restaurante
          </h1>

          <p class="hero-description">
            Responde consultas al instante, gestiona reservas y pedidos, envía confirmaciones y recordatorios, y mantiene el seguimiento después de la visita. Un flujo continuo de asistencia que reduce mensajes repetidos y ayuda a tu equipo a enfocarse en el servicio.
          </p>

          <div class="hero-actions">
            <button type="button" class="btn btn-navy" data-open-quote>
              Reservar una demo
            </button>
            <a href="#automatizaciones" class="btn btn-outline">
              Ver etapas del servicio
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>

          <!-- Microcopy de confianza -->
          <div class="hero-microcopy">
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Implementación guiada</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Integración con tus herramientas</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Enfoque en experiencia y ventas</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Flujo interactivo del Restaurante (Consulta → Reserva/Pedido → Confirmación → Experiencia → Feedback) -->
        <div class="hero-visual-col" data-aos="fade-left" data-aos-delay="150">
          <div class="flow-visual-wrapper">
            <div class="flow-glass-card">
              
              <div class="flow-card-header">
                <div class="live-indicator">
                  <span class="pulse-dot"></span>
                  <span class="live-label">Agente Gastronómico IA Activo</span>
                </div>
                <span class="channel-pill">WhatsApp • Menú Digital • POS</span>
              </div>

              <!-- Pipeline de 5 etapas del Servicio Gastronómico -->
              <div class="flow-stream">
                
                <!-- Etapa 1: Consulta -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">1. Consulta entrante</span>
                      <span class="flow-step-meta">WhatsApp • 19:40 hs</span>
                    </div>
                    <div class="chat-bubble user-bubble">
                      "Hola! ¿Tienen mesa para 4 hoy a las 21:30 hs? ¿Tienen opciones sin TACC y son pet friendly?"
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 2: Reserva / Pedido -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">2. Reserva confirmada</span>
                      <span class="flow-badge-ai">Mesa asignada ✓</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>¡Hola Sofía! Sí, tenemos disponibilidad en terraza (apta mascotas 🐾) y contamos con carta certificada sin TACC 🌾. ¿Te confirmo la mesa para 4 a las 21:30 hs?</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 3: Confirmación y Recordatorio -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">3. Recordatorio interactivo</span>
                      <span class="flow-step-meta">2 hs antes de la visita</span>
                    </div>
                    <div class="property-match-mini">
                      <div class="prop-thumb">🍽️</div>
                      <div class="prop-details">
                        <span class="prop-title">Reserva #3108 • 21:30 hs (4 pers)</span>
                        <span class="prop-sub">Terraza • Tolerancia 15 min • Ubicación enviada</span>
                      </div>
                      <span class="prop-badge">Confirmada</span>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 4: Experiencia / Pedido Take Away -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                      <line x1="3" y1="6" x2="21" y2="6"></line>
                      <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">4. Experiencia y Pedidos</span>
                      <span class="flow-badge-confirmed">Comanda en Cocina</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>¡Tu pedido para take away #89 ya está en marcha! Estará listo para retirar en barra a las <strong>21:15 hs</strong>. Te adjuntamos el detalle con el link de pago.</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 5: Feedback y Fidelización -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle purple-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">5. Feedback y Fidelización</span>
                      <span class="flow-step-meta">Post-visita automático</span>
                    </div>
                    <div class="crm-sync-box">
                      <span class="crm-tag">Encuesta 5★ Enviada</span>
                      <span class="crm-tag">Google Reviews</span>
                      <span class="crm-tag">Beneficio próx. visita</span>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Barra de integraciones en el pie del Hero visual -->
              <div class="flow-systems-bar">
                <span class="systems-label">Sincronizado con:</span>
                <span class="system-tag">Sistema de Reservas</span>
                <span class="system-tag">WhatsApp API</span>
                <span class="system-tag">POS / Comandas</span>
                <span class="system-tag">Google Maps</span>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 2. EL PROBLEMA (Cuando el salón se llena, el WhatsApp también) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="problema" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">El Cuello de Botella Gastronómico</div>
        <h2 class="section-title">Cuando el salón se llena, el WhatsApp también</h2>
        <p class="section-subtitle">
          Entre despachar comandas, acomodar comensales y atender las mesas, responder decenas de mensajes a tiempo resulta imposible y se pierden reservas valiosas.
        </p>
      </div>

      <div class="problem-grid">
        
        <!-- Problema 1 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="100">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Preguntas repetidas en los momentos de mayor trabajo</h3>
            <p>Horarios, dirección, estacionamiento, carta digital, opciones veganas, sin TACC y medios de pago consultados una y otra vez en pleno turno pico.</p>
          </div>
        </div>

        <!-- Problema 2 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="150">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Reservas con idas y vueltas y mesas mal asignadas</h3>
            <p>Múltiples mensajes para coordinar un horario, falta de confirmación de sectores (adentro o afuera) y sobreventa de mesas en noches de alta demanda.</p>
          </div>
        </div>

        <!-- Problema 3 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="200">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Pedidos por chat desordenados y confusos</h3>
            <p>Comandas enviadas por WhatsApp sin aclaraciones de cocción, agregados o notas especiales que generan errores en cocina y demoras en entregas.</p>
          </div>
        </div>

        <!-- Problema 4 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="250">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path>
              <line x1="12" y1="2" x2="12" y2="12"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Mesas vacías por cancelaciones y no-shows</h3>
            <p>Comensales que no se presentan a su reserva porque no recibieron un recordatorio automático previo con botón para confirmar o liberar la mesa a tiempo.</p>
          </div>
        </div>

        <!-- Problema 5 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="300">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Eventos y grupos grandes que nadie responde rápido</h3>
            <p>Cumpleaños o cenas corporativas que requieren propuesta de menú cerrado y se pierden porque el encargado no puede contestar en el momento.</p>
          </div>
        </div>

        <!-- Problema 6 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="350">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Falta de seguimiento post-visita y pocas reseñas</h3>
            <p>Clientes satisfechos que se marchan sin dejar su opinión en Google Maps o TripAdvisor por falta de una solicitud amable y oportuna tras la comida.</p>
          </div>
        </div>

      </div>

      <!-- Cierre destacado de la sección -->
      <div class="problem-closing-banner" data-aos="fade-up">
        <div class="closing-banner-inner">
          <div class="closing-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 16a6 6 0 0 0-12 0Z"></path>
              <line x1="2" y1="16" x2="22" y2="16"></line>
              <line x1="12" y1="6" x2="12" y2="10"></line>
              <circle cx="12" cy="5" r="1" fill="#ffffff"></circle>
              <line x1="4" y1="20" x2="20" y2="20"></line>
            </svg>
          </div>
          <p class="closing-text">
            <strong>La IA no reemplaza al equipo:</strong> automatiza lo repetitivo para que el staff atienda mejor en el salón y la cocina trabaje con fluidez.
          </p>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 3. QUÉ HACE UN AGENTE DE IA PARA RESTAURANTES -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container bg-subtle" id="que-hace" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Evolución Tecnológica en Gastronomía</div>
        <h2 class="section-title">Más que responder: entiende, decide y ejecuta</h2>
        <p class="section-subtitle">
          Un chatbot convencional solo muestra opciones rígidas. Un Agente de IA para Restaurantes comprende la intención, aplica las reglas del local y ejecuta acciones en vivo.
        </p>
      </div>

      <div class="comparison-grid">
        
        <!-- Card 1: Chatbot tradicional -->
        <div class="comp-card bot-card" data-aos="fade-up" data-aos-delay="100">
          <div class="comp-header">
            <span class="comp-type-badge basic">Enfoque Limitado</span>
            <h3 class="comp-title">Chatbot tradicional</h3>
            <p class="comp-tagline">Responde FAQs aisladas</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>Menús numéricos ("Marcá 1 para ver la carta, 2 para reservar, 3 para horarios").</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>Respuestas fijas sin chequear si realmente quedan mesas disponibles esa noche.</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>No entiende pedidos con variantes ("2 burgers sin cebolla y papas con cheddar aparte").</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>No gestiona lista de espera ni se conecta al sistema de comandas o POS.</span>
            </li>
          </ul>
        </div>

        <!-- Card 2: Agente IA - Entiende intención -->
        <div class="comp-card agent-card featured" data-aos="fade-up" data-aos-delay="200">
          <div class="comp-badge-recommended">Inteligencia y Contexto</div>
          <div class="comp-header">
            <span class="comp-type-badge premium">Agente de IA</span>
            <h3 class="comp-title">Entiende intención y contexto</h3>
            <p class="comp-tagline">Reserva, pedido, evento o consulta</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Comprende texto libre y mensajes de audio de manera natural y cercana.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Distingue entre una consulta casual, una reserva formal o un pedido para llevar.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Identifica preferencias alimentarias, ocasiones especiales (cumpleaños) y sectores deseados.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Aplica el tono de comunicación de tu marca (cálido, gourmet, descontracturado o bar).</span>
            </li>
          </ul>
        </div>

        <!-- Card 3: Agente IA - Ejecuta acciones -->
        <div class="comp-card agent-card action" data-aos="fade-up" data-aos-delay="300">
          <div class="comp-badge-recommended action-badge">Capacidad Operativa</div>
          <div class="comp-header">
            <span class="comp-type-badge accent">Agente de IA</span>
            <h3 class="comp-title">Ejecuta acciones operativas</h3>
            <p class="comp-tagline">Confirmar, agendar, registrar y derivar</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Chequea disponibilidad de turnos o turneras y confirma la reserva al instante.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Toma pedidos guiados con adicionales, calcula el total y envía el link de cobro.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Gestiona lista de espera automática y avisa al cliente cuando se desocupa una mesa.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Dispara recordatorios interactivos y deriva al encargado ante casos especiales.</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Texto simple complementario -->
      <div class="what-it-does-summary" data-aos="fade-up">
        <p>
          El agente puede <strong>conectarse a tu sistema de reservas, carta digital, stock disponible</strong> (si existe) y canales de mensajería para mantener toda la operación sincronizada sin fricciones.
        </p>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 4. BENEFICIOS PARA TU RESTAURANTE Y TUS CLIENTES -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="beneficios" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Impacto Operativo y Comercial</div>
        <h2 class="section-title">Beneficios para tu restaurante y tus clientes</h2>
        <p class="section-subtitle">
          Diseñado para que locales gastronómicos independientes, cafeterías de especialidad, bares y cadenas reduzcan el caos en el chat y aumenten la facturación por mesa.
        </p>
      </div>

      <div class="benefits-grid">
        
        <!-- Beneficio 1 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="100">
          <div class="benefit-icon-wrapper blue-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3>Respuestas inmediatas 24/7</h3>
          <p>
            Atención al instante en cualquier horario: los comensales reciben la carta, horarios y disponibilidad sin esperar a que el local abra sus puertas.
          </p>
        </div>

        <!-- Beneficio 2 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="150">
          <div class="benefit-icon-wrapper green-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 16a6 6 0 0 0-12 0Z"></path>
              <line x1="2" y1="16" x2="22" y2="16"></line>
              <line x1="12" y1="6" x2="12" y2="10"></line>
              <circle cx="12" cy="5" r="1" fill="#15C63B"></circle>
              <line x1="4" y1="20" x2="20" y2="20"></line>
            </svg>
          </div>
          <h3>Menos carga de mensajes en horas pico</h3>
          <p>
            Tu equipo de salón y barra no se distrae respondiendo el teléfono o WhatsApp durante el despacho de comidas, mejorando la atención en mesa.
          </p>
        </div>

