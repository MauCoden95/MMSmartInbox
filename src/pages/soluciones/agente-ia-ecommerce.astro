    justify-content: center;
    flex-shrink: 0;
  }

  .problem-content h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
    margin-bottom: 0.4rem;
  }

  .problem-content p {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.6;
  }

  .problem-highlight-banner {
    background: linear-gradient(135deg, #071548, #0b2591);
    color: white;
    border-radius: 18px;
    padding: 2.2rem 2.8rem;
    display: flex;
    align-items: center;
    gap: 1.8rem;
    box-shadow: 0 16px 36px rgba(11, 37, 145, 0.18);
  }

  .banner-icon-circle {
    width: 60px;
    height: 60px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .highlight-phrase {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.5;
    color: #ffffff;
    margin: 0;
  }

  /* ============================================================== */
  /* 3. COMPARATIVA (Qué hace el Agente)                            */
  /* ============================================================== */
  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .comparison-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 2rem 1.8rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s ease;
  }

  .comparison-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 35px rgba(0, 0, 0, 0.06);
  }

  .card-featured-pill {
    position: absolute;
    top: -12px;
    right: 24px;
    background: var(--color-primary-green, #15C63B);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    box-shadow: 0 3px 10px rgba(21, 198, 59, 0.35);
  }

  .featured-card {
    border: 2px solid #15C63B;
    background: #fcfffd;
  }

  .card-status-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  .badge-neutral {
    background: #f1f5f9;
    color: #64748b;
  }

  .badge-blue {
    background: rgba(11, 37, 145, 0.08);
    color: #0b2591;
  }

  .badge-green {
    background: rgba(21, 198, 59, 0.12);
    color: #0c7524;
  }

  .comparison-card-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    margin-bottom: 0.6rem;
  }

  .comparison-summary {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.55;
    margin-bottom: 1.4rem;
    min-height: 44px;
  }

  .comparison-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.8rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
  }

  .comparison-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .negative-item {
    color: #64748b;
  }

  .negative-item .icon-cross {
    color: #ef4444;
    font-weight: 800;
    margin-top: 1px;
  }

  .positive-item {
    color: #1e293b;
  }

  .positive-item .icon-check {
    color: var(--color-primary-green, #15C63B);
    font-weight: 800;
    margin-top: 1px;
  }

  .comparison-footer {
    padding-top: 1.2rem;
    border-top: 1px solid #f1f5f9;
  }

  .tag-outcome {
    font-size: 0.78rem;
    font-weight: 700;
    display: block;
    text-align: center;
    padding: 0.45rem;
    border-radius: 6px;
  }

  .outcome-bad {
    background: #fee2e2;
    color: #991b1b;
  }

  .outcome-blue {
    background: #eff6ff;
    color: #0b2591;
  }

  .outcome-green {
    background: #e8faed;
    color: #0c7524;
  }

  /* ============================================================== */
  /* 4. BENEFICIOS                                                  */
  /* ============================================================== */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }

  .benefit-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 2rem 1.6rem;
    transition: all 0.25s ease;
  }

  .benefit-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
    border-color: #cbd5e1;
  }

  .benefit-icon-box {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: rgba(11, 37, 145, 0.08);
    color: #0b2591;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem;
    transition: all 0.25s ease;
  }

  .benefit-item:hover .benefit-icon-box {
    background: #0b2591;
    color: #ffffff;
  }

  .benefit-item h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .benefit-item p {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  /* ============================================================== */
  /* 5. JOURNEY TABS (Núcleo)                                       */
  /* ============================================================== */
  .journey-tabs-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  .journey-tab-btn {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
    font-family: inherit;
  }

  .journey-tab-btn:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
  }

  .journey-tab-btn.is-active {
    background: #0b2591;
    border-color: #0b2591;
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(11, 37, 145, 0.2);
  }

  .journey-tab-btn .tab-num {
    font-size: 0.95rem;
    font-weight: 800;
    opacity: 0.6;
  }

  .journey-tab-btn.is-active .tab-num {
    opacity: 0.9;
    color: #15C63B;
  }

  .journey-tab-btn .tab-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.3;
  }

  .journey-tab-btn.is-active .tab-label {
    color: #ffffff;
  }

  .journey-tabs-content {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 2.8rem;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.04);
    margin-bottom: 2.5rem;
  }

  .journey-tab-panel {
    display: none;
  }

  .journey-tab-panel.is-active {
    display: block;
    animation: fadeIn 0.35s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  .panel-step-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #0b2591;
    background: rgba(11, 37, 145, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    display: inline-block;
    margin-bottom: 0.8rem;
  }

  .panel-text h3 {
    font-size: 1.7rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    margin-bottom: 0.8rem;
  }

  .panel-text > p {
    font-size: 0.95rem;
    color: #475569;
    line-height: 1.65;
    margin-bottom: 1.6rem;
  }

  .panel-features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .panel-features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #334155;
  }

  .feature-bullet {
    width: 8px;
    height: 8px;
    background: var(--color-primary-green, #15C63B);
    border-radius: 50%;
    margin-top: 6px;
    flex-shrink: 0;
  }

  .panel-features-list strong {
    color: #0f172a;
    display: block;
    margin-bottom: 0.2rem;
  }

  /* Simulation Terminal Box */
  .panel-simulation {
    background: #0f172a;
    border-radius: 16px;
    border: 1px solid #1e293b;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
  }

  .sim-header {
    background: #1e293b;
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sim-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .sim-dot.red { background: #ef4444; }
  .sim-dot.yellow { background: #f59e0b; }
  .sim-dot.green { background: #10b981; }

  .sim-title {
    font-size: 0.72rem;
    color: #94a3b8;
    margin-left: 0.6rem;
    font-weight: 600;
  }

  .sim-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    font-size: 0.84rem;
  }

  .sim-msg {
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    line-height: 1.45;
  }

  .sim-msg.user {
    background: #334155;
    color: #f1f5f9;
    align-self: flex-start;
  }

  .sim-msg.bot {
    background: rgba(11, 37, 145, 0.4);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #ffffff;
  }

  .sim-thinking {
    font-size: 0.75rem;
    color: #72e475;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: monospace;
  }

  .sim-gear {
    animation: spin 3s linear infinite;
    display: inline-block;
  }

  @keyframes spin {
    100% { transform: rotate(360deg); }
  }

  .sim-action-chip {
    font-size: 0.74rem;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    align-self: flex-start;
  }

  /* Escalation Callout Box */
  .escalation-box {
    background: #f8faff;
    border: 1.5px solid #dbeafe;
    border-radius: 20px;
    padding: 2.2rem 2.4rem;
  }

  .escalation-header {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    margin-bottom: 1.8rem;
  }

  .escalation-icon {
    width: 48px;
    height: 48px;
    background: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .escalation-header h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0b2591;
    margin-bottom: 0.3rem;
  }

  .escalation-header p {
    font-size: 0.9rem;
    color: #475569;
    margin: 0;
  }

  .escalation-cases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .escalation-case {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.2rem 1.4rem;
    display: flex;
    gap: 0.9rem;
  }

  .case-number {
    width: 28px;
    height: 28px;
    background: rgba(11, 37, 145, 0.08);
    color: #0b2591;
    font-weight: 800;
    font-size: 0.85rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .escalation-case strong {
    font-size: 0.88rem;
    color: #0f172a;
    display: block;
    margin-bottom: 0.25rem;
    line-height: 1.35;
  }

  .escalation-case p {
    font-size: 0.82rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
  }

  /* ============================================================== */
  /* 6. IMPLEMENTACIÓN                                              */
  /* ============================================================== */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem;
    margin-bottom: 2.2rem;
  }

  .step-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 2.4rem 1.8rem;
    position: relative;
    transition: all 0.25s ease;
  }

  .step-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
    border-color: #cbd5e1;
  }

  .step-badge {
    position: absolute;
    top: 1.8rem;
    right: 1.8rem;
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #0b2591;
    background: rgba(11, 37, 145, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  .step-icon-wrap {
    width: 52px;
    height: 52px;
    background: rgba(21, 198, 59, 0.12);
    color: #15C63B;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .step-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
    margin-bottom: 0.8rem;
  }

  .step-card p {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  .stack-clarification-banner {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--color-primary-green, #15C63B);
    border-radius: 12px;
    padding: 1.2rem 1.6rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }

  .clarification-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(21, 198, 59, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stack-clarification-banner p {
    font-size: 0.92rem;
    color: #334155;
    margin: 0;
  }

  /* ============================================================== */
  /* 7. INTEGRACIONES                                               */
  /* ============================================================== */
  .integrations-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.2rem;
  }

  .integration-tile {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.6rem 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.25s ease;
  }

  .integration-tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    border-color: #cbd5e1;
  }

  .tile-icon-box {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: #f8fafc;
    border: 1px solid #edf2f7;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.9rem;
    transition: transform 0.2s ease;
  }

  .integration-tile:hover .tile-icon-box {
    transform: scale(1.08);
  }

  .tile-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.25rem;
  }

  .tile-desc {
    font-size: 0.76rem;
    color: #64748b;
    line-height: 1.4;
  }

  /* ============================================================== */
  /* 8. CASOS DE USO                                                */
  /* ============================================================== */
  .use-cases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.8rem;
  }

  .use-case-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 2.2rem 2rem;
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
  }

  .use-case-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
    border-color: #cbd5e1;
  }

  .case-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
  }

  .case-tag {
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  .tag-blue { background: #eff6ff; color: #0b2591; }
  .tag-green { background: #e8faed; color: #0c7524; }
  .tag-purple { background: #f5f3ff; color: #6d28d9; }
  .tag-amber { background: #fef3c7; color: #b45309; }

  .case-icon-mini {
    font-size: 1.3rem;
  }

  .case-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.35;
    margin-bottom: 1.4rem;
  }

  .case-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .scenario-label {
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 0.2rem;
  }

  .case-scenario .scenario-label {
    color: #ef4444;
  }

  .case-resolution .scenario-label {
    color: #15C63B;
  }

  .case-scenario p {
    color: #64748b;
    margin: 0;
  }

  .case-resolution p {
    color: #1e293b;
    margin: 0;
  }

  /* ============================================================== */
  /* 9. FAQ ACCORDION                                               */
  /* ============================================================== */
  .faq-accordion-container {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq-item:hover {
    border-color: #cbd5e1;
  }

  .faq-item.is-open {
    border-color: #0b2591;
    box-shadow: 0 4px 18px rgba(11, 37, 145, 0.08);
  }

  .faq-question-btn {
    width: 100%;
    padding: 1.4rem 1.6rem;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    gap: 1rem;
  }

  .faq-chevron {
    font-size: 1.2rem;
    color: #64748b;
    transition: transform 0.25s ease;
  }

  .faq-item.is-open .faq-chevron {
    transform: rotate(180deg);
    color: #0b2591;
  }

  .faq-answer-panel {
    display: none;
    padding: 0 1.6rem 1.4rem;
  }

  .faq-item.is-open .faq-answer-panel {
    display: block;
    animation: fadeIn 0.25s ease;
  }

  .faq-answer-panel p {
    font-size: 0.92rem;
    color: #475569;
    line-height: 1.65;
    margin: 0;
  }

  /* ============================================================== */
  /* 10. CTA FINAL                                                  */
  /* ============================================================== */
  .cta-section {
    max-width: 1140px;
    width: 92%;
    margin: 4.5rem auto 2rem;
  }

  .cta-inner-card {
    background: linear-gradient(135deg, #071548 0%, #0b2591 100%);
    border-radius: 28px;
    padding: 4.5rem 3rem;
    text-align: center;
    color: #ffffff;
    box-shadow: 0 20px 50px rgba(11, 37, 145, 0.25);
    position: relative;
    overflow: hidden;
  }

  .cta-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #72e475;
    background: rgba(114, 228, 117, 0.12);
    border: 1px solid rgba(114, 228, 117, 0.25);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.2rem;
  }

  .cta-title {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.8px;
    color: #ffffff;
    max-width: 720px;
