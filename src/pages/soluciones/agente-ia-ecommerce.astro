---
import Layout from '../../layouts/Layout.astro';
import DemoModal from '../../components/DemoModal.astro';
---

<Layout
  title="Agentes de IA para eCommerce | MM SmartInbox"
  description="IA que ayuda a los compradores a completar el recorrido. Automatiza búsqueda, dudas de producto, carritos y postcompra conectado a tu catálogo, stock y pedidos."
>
  <div class="ecommerce-page">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 1. HERO / BANNER -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="hero-section" id="hero">
      <div class="hero-container">
        
        <!-- Columna Izquierda: Texto y CTA -->
        <div class="hero-text-col" data-aos="fade-right">
          <div class="hero-badge">
            <span class="badge-pulse"></span>
            <span>Solución de IA para Tiendas Online</span>
          </div>

          <h1 class="hero-title">
            IA que ayuda a los compradores a completar el recorrido
          </h1>

          <p class="hero-description">
            Transforma la búsqueda de productos, los momentos en el carrito y la asistencia posterior a la compra en un flujo continuo de asistencia, permitiendo que los equipos recuperen el ritmo en lugar de repetir las mismas respuestas.
          </p>

          <div class="hero-actions">
            <button type="button" class="btn btn-navy" data-open-quote>
              Reservar una demo
            </button>
            <a href="#journey" class="btn btn-outline">
              Ver el recorrido
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>

          <!-- Microcopy de confianza -->
          <div class="hero-microcopy">
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Implementación guiada</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Integración con tus sistemas</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Enfoque en resultados</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Ilustración del Flujo del Journey -->
        <div class="hero-visual-col" data-aos="fade-left" data-aos-delay="150">
          <div class="journey-visual-wrapper">
            <div class="journey-glass-card">
              
              <div class="journey-card-header">
                <div class="live-indicator">
                  <span class="pulse-dot"></span>
                  <span class="live-label">Agente de IA Conectado en Tiempo Real</span>
                </div>
                <span class="channel-pill">WhatsApp + Web</span>
              </div>

              <!-- Journey Steps Interactive Mockup -->
              <div class="journey-flow-stream">
                
                <!-- Etapa 1: Búsqueda -->
                <div class="flow-node node-search">
                  <div class="node-icon-box blue-theme">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                  </div>
                  <div class="node-content">
                    <div class="node-step-tag">1. Búsqueda y Selección</div>
                    <div class="chat-bubble user-bubble">
                      "¿Tienen en talle M color negro y cuándo llega a Palermo?"
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>¡Sí! Tenemos <strong>4 unidades en stock</strong>. Si pedís antes de las 14hs, llega hoy con envío rápido.</p>
                    </div>
                  </div>
                </div>

                <!-- Línea conectora animada -->
                <div class="flow-connector">
                  <div class="connector-line"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 2: Carrito -->
                <div class="flow-node node-cart">
                  <div class="node-icon-box green-theme">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="8" cy="21" r="1"></circle>
                      <circle cx="19" cy="21" r="1"></circle>
                      <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                    </svg>
                  </div>
                  <div class="node-content">
                    <div class="node-step-tag">2. Carrito y Checkout</div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>Resolví tu duda: tenés <strong>3 cuotas sin interés</strong> con Mercado Pago. Apliqué tu cupón <em>BIENVENIDA</em> (-10%).</p>
                    </div>
                    <div class="action-badge-pill">
                      <span>✓ Enlace de pago generado automáticamente</span>
                    </div>
                  </div>
                </div>

                <!-- Línea conectora animada -->
                <div class="flow-connector">
                  <div class="connector-line"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 3: Postcompra -->
                <div class="flow-node node-post">
                  <div class="node-icon-box purple-theme">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                      <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                  </div>
                  <div class="node-content">
                    <div class="node-step-tag">3. Postcompra y Seguimiento</div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>Pedido <strong>#4829</strong> en camino con Andreani. Código: <em>AR-993821</em>. ¿Necesitas factura A o B?</p>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Integration Footer Pill inside Hero Visual -->
              <div class="journey-systems-bar">
                <span class="systems-label">Sincronizado con:</span>
                <span class="system-tag">Shopify</span>
                <span class="system-tag">WooCommerce</span>
                <span class="system-tag">Mercado Pago</span>
                <span class="system-tag">Stock API</span>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 2. EL PROBLEMA (Identificación) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="problema" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">El Desafío Operativo</div>
        <h2 class="section-title">Cuando la tienda crece, las preguntas se repiten</h2>
        <p class="section-subtitle">
          El tráfico aumenta, pero la atención manual se convierte en un cuello de botella que ralentiza tus ventas y agota la energía de tu equipo.
        </p>
      </div>

      <div class="problem-grid">
        
        <div class="problem-card" data-aos="fade-up" data-aos-delay="100">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Demoras críticas en preguntas de stock, talles y envíos</h3>
            <p>Los compradores esperan inmediatez. Si tardas 20 minutos en confirmar si hay stock o cuánto demora el envío, van a buscarlo a otra tienda.</p>
          </div>
        </div>

        <div class="problem-card" data-aos="fade-up" data-aos-delay="150">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Carritos abandonados por dudas simples no resueltas</h3>
            <p>Preguntas sobre costos de envío, cuotas de tarjetas o plazos de entrega frenan la decisión en el checkout sin que nadie asista al comprador.</p>
          </div>
        </div>

        <div class="problem-card" data-aos="fade-up" data-aos-delay="200">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Equipos saturados respondiendo lo mismo todos los días</h3>
            <p>Operadores valiosos consumen horas copiando y pegando datos de tablas de talles, links de seguimiento o medios de pago en lugar de vender.</p>
          </div>
        </div>

        <div class="problem-card" data-aos="fade-up" data-aos-delay="250">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Información repartida entre plataformas y planillas</h3>
            <p>Catálogo en Shopify o WooCommerce, pedidos en el correo, stock en planillas y mensajes en WhatsApp: datos fragmentados que generan errores.</p>
          </div>
        </div>

        <div class="problem-card" data-aos="fade-up" data-aos-delay="300">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Postcompra con seguimiento manual y fricciones</h3>
            <p>El cliente quiere saber dónde está su paquete o cómo gestionar un cambio, y la falta de tracking automatizado satura los canales de reclamos.</p>
          </div>
        </div>

      </div>

      <!-- Frase de cierre requerida -->
      <div class="problem-highlight-banner" data-aos="zoom-in" data-aos-delay="350">
        <div class="banner-icon-circle">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#15C63B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <p class="highlight-phrase">
          “La IA no reemplaza al equipo: le quita trabajo repetitivo para que se enfoque en lo importante.”
        </p>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 3. QUÉ HACE UN AGENTE DE IA (Educación clara) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="que-hace" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Tecnología Inteligente vs. Bots Antiguos</div>
        <h2 class="section-title">Más que responder: entiende, decide y ejecuta</h2>
        <p class="section-subtitle max-w-700">
          Nuestro agente de IA no recita textos fijos. Se conecta en tiempo real a tu catálogo de productos, políticas comerciales, pedidos y CRM para actuar con autonomía guiada y reglas claras.
        </p>
      </div>

      <div class="comparison-grid">
        
        <!-- Card 1: Chatbot tradicional -->
        <div class="comparison-card card-traditional" data-aos="fade-up" data-aos-delay="100">
          <div class="card-status-badge badge-neutral">Chatbot tradicional</div>
          <h3 class="comparison-card-title">Responde</h3>
          <p class="comparison-summary">
            Árboles de opciones rígidos basados en palabras clave exactas.
          </p>
          
          <ul class="comparison-list">
            <li class="negative-item">
              <span class="icon-cross">✕</span>
              <span>Menús estáticos: "Presiona 1 para ver talles, 2 para envíos".</span>
            </li>
            <li class="negative-item">
              <span class="icon-cross">✕</span>
              <span>No sabe si hay stock real ni puede consultar variantes.</span>
            </li>
            <li class="negative-item">
              <span class="icon-cross">✕</span>
              <span>Se traba ante faltas de ortografía o preguntas compuestas.</span>
            </li>
            <li class="negative-item">
              <span class="icon-cross">✕</span>
              <span>Genera frustración y deriva todo a humanos sin contexto.</span>
            </li>
          </ul>
          
          <div class="comparison-footer">
            <span class="tag-outcome outcome-bad">Limitado a guiones mecánicos</span>
          </div>
        </div>

        <!-- Card 2: Agente de IA: Entiende -->
        <div class="comparison-card card-ai-understand" data-aos="fade-up" data-aos-delay="200">
          <div class="card-status-badge badge-blue">Agente de IA</div>
          <h3 class="comparison-card-title">Entiende el contexto</h3>
          <p class="comparison-summary">
            Comprende lenguaje natural, audios y las dudas implícitas del cliente.
          </p>

          <ul class="comparison-list">
            <li class="positive-item">
              <span class="icon-check">✓</span>
              <span>Interpreta intención de compra, dudas y modismos cotidianos.</span>
            </li>
            <li class="positive-item">
              <span class="icon-check">✓</span>
              <span>Recuerda el hilo de la charla y el historial del comprador.</span>
            </li>
            <li class="positive-item">
              <span class="icon-check">✓</span>
              <span>Identifica dudas antes de pagar (financiación, garantías).</span>
            </li>
            <li class="positive-item">
              <span class="icon-check">✓</span>
              <span>Mantiene el tono de voz y la personalidad de tu marca.</span>
            </li>
          </ul>

          <div class="comparison-footer">
            <span class="tag-outcome outcome-blue">Conversación fluida y humana</span>
          </div>
        </div>

        <!-- Card 3: Agente de IA: Ejecuta acciones -->
        <div class="comparison-card card-ai-action featured-card" data-aos="fade-up" data-aos-delay="300">
          <div class="card-featured-pill">Máximo Impacto</div>
          <div class="card-status-badge badge-green">Agente de IA Conectado</div>
          <h3 class="comparison-card-title">Ejecuta acciones en tus sistemas</h3>
          <p class="comparison-summary">
            No solo habla: interactúa con tus herramientas y resuelve la operación.
          </p>

          <ul class="comparison-list">
            <li class="positive-item">
              <span class="icon-check">✓</span>
              <span>Consulta stock por variante en Shopify/WooCommerce en vivo.</span>
            </li>
            <li class="positive-item">
              <span class="icon-check">✓</span>
              <span>Genera links de pago y aplica cupones según tus reglas comerciales.</span>
            </li>
            <li class="positive-item">
              <span class="icon-check">✓</span>
              <span>Rastrea números de envío con correos y logística en segundos.</span>
            </li>
            <li class="positive-item">
              <span class="icon-check">✓</span>
              <span>Registra datos en tu CRM y escala casos sensibles al equipo.</span>
            </li>
          </ul>

          <div class="comparison-footer">
            <span class="tag-outcome outcome-green">Resolución completa de punta a punta</span>
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 4. BENEFICIOS (Valor de negocio) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="beneficios" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Impacto Real</div>
        <h2 class="section-title">Beneficios para tu tienda y tu equipo</h2>
        <p class="section-subtitle">
          Automatización que protege la rentabilidad de tu negocio y mejora la experiencia de tus compradores sin promesas irreales.
        </p>
      </div>

      <div class="benefits-grid">
        
        <div class="benefit-item" data-aos="fade-up" data-aos-delay="100">
          <div class="benefit-icon-box">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 14 14"></polyline>
            </svg>
          </div>
          <h3>Respuestas consistentes 24/7</h3>
          <p>Tus clientes reciben información precisa sobre stock, medidas y envíos al instante, incluso a la medianoche, feriados o durante campañas como Hot Sale.</p>
        </div>

        <div class="benefit-item" data-aos="fade-up" data-aos-delay="150">
          <div class="benefit-icon-box">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
              <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
            </svg>
          </div>
          <h3>Menos tickets repetitivos</h3>
          <p>Hasta el 70% de las consultas habituales de tu tienda son resueltas en el primer contacto, liberando tiempo para que tus agentes gestionen ventas de alto valor.</p>
        </div>

        <div class="benefit-item" data-aos="fade-up" data-aos-delay="200">
          <div class="benefit-icon-box">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3>Mejor conversión asistida</h3>
          <p>Acompaña a usuarios indecisos resolviendo preguntas de compatibilidad, cuotas y despacho justo en el segundo previo a abandonar la web.</p>
        </div>

        <div class="benefit-item" data-aos="fade-up" data-aos-delay="250">
          <div class="benefit-icon-box">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <polyline points="16 11 18 13 22 9"></polyline>
            </svg>
          </div>
          <h3>Recuperación de carritos contextual</h3>
          <p>Seguimientos por WhatsApp o Email que van al grano: en lugar de un mensaje genérico, abordan el motivo real de la duda y facilitan el pago.</p>
        </div>

        <div class="benefit-item" data-aos="fade-up" data-aos-delay="300">
          <div class="benefit-icon-box">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
          </div>
          <h3>Mejor experiencia postcompra</h3>
          <p>Estados de pedido actualizados, guías de cambios y devoluciones con pasos claros: tranquilidad inmediata para el comprador y menor tasa de reclamos.</p>
        </div>

        <div class="benefit-item" data-aos="fade-up" data-aos-delay="350">
          <div class="benefit-icon-box">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <h3>Visibilidad y orden analítico</h3>
          <p>Descubre qué productos generan más dudas, qué talles faltan con mayor frecuencia y cuáles son las principales objeciones comerciales registradas.</p>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 5. AUTOMATIZACIONES A LO LARGO DEL RECORRIDO (Núcleo) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="journey" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">El Recorrido del Comprador</div>
        <h2 class="section-title">Automatización en cada momento del journey</h2>
        <p class="section-subtitle">
          Desde la primera visita hasta la entrega del producto: asistencia continua e inteligente conectada a tus herramientas.
        </p>
      </div>

      <!-- Tabs Navigation -->
      <div class="journey-tabs-nav" role="tablist">
        <button type="button" class="journey-tab-btn is-active" data-tab="tab-search" role="tab" aria-selected="true" aria-controls="tab-search">
          <span class="tab-num">01</span>
          <span class="tab-label">Búsqueda y descubrimiento</span>
        </button>
        <button type="button" class="journey-tab-btn" data-tab="tab-product" role="tab" aria-selected="false" aria-controls="tab-product">
          <span class="tab-num">02</span>
