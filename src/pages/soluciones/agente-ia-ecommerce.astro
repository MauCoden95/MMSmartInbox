---
import Layout from '../../layouts/Layout.astro';
import DemoModal from '../../components/DemoModal.astro';
---

<Layout
  title="Agentes de IA para eCommerce y Operaciones Internas | MM SmartInbox"
  description="IA que ayuda a los compradores a completar el recorrido y automatiza tus operaciones internas: pedidos, stock, logística, devoluciones y reportes conectados a tu stack."
>
  <div class="ecommerce-page">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 1. HERO / BANNER -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="hero-section" id="hero">
      <div class="hero-container">
        
        <!-- Columna Izquierda: Texto y CTA -->
        <div class="hero-text-col" data-aos="fade-right">
          <div class="hero-badge">
            <span class="badge-pulse"></span>
            <span>Agentes de IA para eCommerce, Tiendas Online y Marcas D2C</span>
          </div>

          <h1 class="hero-title">
            IA que ayuda a los compradores a completar el recorrido
          </h1>

          <p class="hero-description">
            Transforma la búsqueda de productos, los momentos en el carrito y la asistencia posterior a la compra en un flujo continuo de asistencia, permitiendo que los equipos recuperen el ritmo en lugar de repetir las mismas respuestas.
          </p>

          <div class="hero-actions">
            <button type="button" class="btn btn-navy" data-open-quote>
              Reservar una demo
            </button>
            <a href="#automatizaciones" class="btn btn-outline">
              Ver flujos internos
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>

          <!-- Microcopy bajo CTA -->
          <div class="hero-microcopy">
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Implementación guiada</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Integración con tus sistemas</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>IA aplicada a operación y ventas</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Visual Journey de eCommerce -->
        <div class="hero-visual-col" data-aos="fade-left" data-aos-delay="150">
          <div class="flow-visual-wrapper">
            <div class="flow-glass-card">
              
              <div class="flow-card-header">
                <div class="live-indicator">
                  <span class="pulse-dot"></span>
                  <span class="live-label">Agente eCommerce IA Activo</span>
                </div>
                <span class="channel-pill">WhatsApp • Web • ERP Sincronizado</span>
              </div>

              <!-- Pipeline Journey del Comprador -->
              <div class="flow-stream">
                
                <!-- Etapa 1: Consulta -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">1. Consulta</span>
                      <span class="flow-step-meta">WhatsApp • 14:20 hs</span>
                    </div>
                    <div class="chat-bubble user-bubble">
                      "Hola! ¿Tienen stock en talle L negro? ¿Hacen envíos a Córdoba?"
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 2: Carrito y Checkout -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">2. Carrito y Checkout</span>
                      <span class="flow-badge-ai">Disponible en Tienda ✓</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>¡Hola! Sí, tenemos stock en <strong>talle L negro</strong> con despacho en el día. Te dejo el link con <strong>3 cuotas sin interés</strong> y envío gratis:</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 3: Operación y Despacho -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">3. Operación y Despacho</span>
                      <span class="flow-step-meta">Sincronizado con WMS/ERP</span>
                    </div>
                    <div class="property-match-mini">
                      <div class="prop-thumb">📦</div>
                      <div class="prop-details">
                        <span class="prop-title">Orden #4821 creada en Shopify</span>
                        <span class="prop-sub">Etiqueta Andreani generada • Stock actualizado</span>
                      </div>
                      <span class="prop-badge">Completado</span>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 4: Postcompra y Tracking -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">4. Postcompra y Tracking</span>
                      <span class="flow-badge-confirmed">Seguimiento 24/7</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>Tu pedido #4821 está en camino. Código de seguimiento: <strong>AR-99214</strong>. ¿Necesitás factura A o coordinar la entrega?</p>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Barra de integraciones en el pie del Hero visual -->
              <div class="flow-systems-bar">
                <span class="systems-label">Sincronizado con:</span>
                <span class="system-tag">Shopify / WooCommerce</span>
                <span class="system-tag">Mercado Pago</span>
                <span class="system-tag">WMS / ERP</span>
                <span class="system-tag">Andreani</span>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 2. SECCIÓN: NO ES SOLO ATENCIÓN AL CLIENTE -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container bg-subtle" id="operacion-real" data-aos="fade-up">
      <div class="operational-impact-card">
        <div class="section-badge">Automatización Operativa</div>
        <h2 class="impact-title">
          Atención al cliente es solo una parte. El mayor impacto está en la operación.
        </h2>
        
        <p class="impact-lead">
          Un chatbot convencional se limita a responder preguntas con mensajes fijos. Un <strong>Agente de IA</strong> consulta bases de datos en vivo, decide mediante reglas comerciales y ejecuta acciones concretas. La automatización integral conecta tus herramientas para eliminar tareas manuales repetitivas y erradicar la duplicación de información entre departamentos.
        </p>

        <!-- Mini lista sin tecnicismos -->
        <div class="mini-capabilities-grid">
          <div class="mini-cap-item">
            <div class="cap-check">✓</div>
            <div class="cap-info">
              <strong>Actualiza pedidos</strong>
              <span>Cambia estados en tu tienda y ERP al instante.</span>
            </div>
          </div>
          <div class="mini-cap-item">
            <div class="cap-check">✓</div>
            <div class="cap-info">
              <strong>Dispara tareas</strong>
              <span>Crea recordatorios en CRM y órdenes en depósito.</span>
            </div>
          </div>
          <div class="mini-cap-item">
            <div class="cap-check">✓</div>
            <div class="cap-info">
              <strong>Genera reportes</strong>
              <span>Consolida métricas semanales sin tocar planillas.</span>
            </div>
          </div>
          <div class="mini-cap-item">
            <div class="cap-check">✓</div>
            <div class="cap-info">
              <strong>Identifica incidencias</strong>
              <span>Detecta paquetes demorados antes que el cliente.</span>
            </div>
          </div>
          <div class="mini-cap-item">
            <div class="cap-check">✓</div>
            <div class="cap-info">
              <strong>Sugiere próximos pasos</strong>
              <span>Indica qué hacer ante quiebres de stock o reclamos.</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 3. EL PROBLEMA (Identificación) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="el-problema" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">El Desafío del Crecimiento</div>
        <h2 class="section-title">Cuando crece el volumen, se multiplican los detalles</h2>
        <p class="section-subtitle">
          El incremento en ventas trae consigo una avalancha de pequeñas tareas operativas que fragmentan el tiempo de tu equipo y generan errores evitables.
        </p>
      </div>

      <div class="problem-grid">
        
        <div class="problem-card" data-aos="fade-up" data-aos-delay="100">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Consultas repetidas de stock, envíos, cambios y medios de pago</h3>
            <p>El personal responde una y otra vez lo mismo en WhatsApp o chat web mientras las consultas urgentes de ventas quedan en espera.</p>
          </div>
        </div>

        <div class="problem-card" data-aos="fade-up" data-aos-delay="150">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="21" r="1"></circle>
              <circle cx="19" cy="21" r="1"></circle>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Carritos abandonados por dudas simples</h3>
            <p>Costos de envío no claros, opciones de cuotas o compatibilidad de producto frenan la compra justo en el paso final del checkout.</p>
          </div>
        </div>

        <div class="problem-card" data-aos="fade-up" data-aos-delay="200">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Pedidos con incidencias no detectadas a tiempo</h3>
            <p>Direcciones con altura incompleta, códigos postales erróneos, pagos rechazados o faltantes que salen a reparto destinados a fallar.</p>
          </div>
        </div>

        <div class="problem-card" data-aos="fade-up" data-aos-delay="250">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Doble carga de información entre tienda, planillas, logística y CRM</h3>
            <p>Operadores copiando y pegando números de guía, estados de pago y notas de clientes entre cuatro plataformas desconectadas.</p>
          </div>
        </div>

        <div class="problem-card" data-aos="fade-up" data-aos-delay="300">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 4 23 10 17 10"></polyline>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Devoluciones y cambios gestionados manualmente por mensajes</h3>
            <p>Conversaciones caóticas por WhatsApp para coordinar recolecciones, revisar fotos de prendas y emitir notas de crédito o cupones.</p>
          </div>
        </div>

        <div class="problem-card" data-aos="fade-up" data-aos-delay="350">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Reportes y conciliaciones que consumen horas cada semana</h3>
            <p>Cruzar liquidaciones de pasarelas de pago contra ventas de la tienda y pedidos de logística exige días de trabajo de backoffice.</p>
          </div>
        </div>

      </div>

      <!-- Cierre destacado requerido -->
      <div class="problem-closing-banner" data-aos="zoom-in" data-aos-delay="400">
        <div class="closing-banner-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#15C63B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <p class="closing-phrase">
          “La IA no reemplaza al equipo: le quita trabajo repetitivo para que se enfoque en mejorar el negocio.”
        </p>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 4. QUÉ HACE UN AGENTE DE IA EN ECOMMERCE -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container bg-subtle" id="que-hace" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Inteligencia y Ejecución</div>
        <h2 class="section-title">Entiende el contexto y actúa</h2>
        <p class="section-subtitle">
          El agente se conecta al catálogo, pedidos, stock, envíos y herramientas internas para resolver de punta a punta.
        </p>
      </div>

      <div class="three-pillars-grid">
        
        <!-- Card 1: Responde -->
        <div class="pillar-card" data-aos="fade-up" data-aos-delay="100">
          <div class="pillar-icon-box blue">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <h3 class="pillar-title">Responde</h3>
          <span class="pillar-subtitle">Información consistente 24/7</span>
          <p class="pillar-desc">
            Brinda respuestas exactas y actualizadas basadas en tus fichas de producto, políticas de cambio, tiempos de flete y medios de pago.
          </p>
          <ul class="pillar-bullets">
            <li>✓ Consulta especificaciones técnicas y talles.</li>
            <li>✓ Explica políticas de garantía sin contradicciones.</li>
            <li>✓ Atiende simultáneamente en WhatsApp y web.</li>
          </ul>
        </div>

        <!-- Card 2: Asiste la compra -->
        <div class="pillar-card highlight-pillar" data-aos="fade-up" data-aos-delay="150">
          <div class="pillar-icon-box green">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
          </div>
          <div class="pillar-tag">Foco en Conversión</div>
          <h3 class="pillar-title">Asiste la compra</h3>
          <span class="pillar-subtitle">Recomendaciones y objeciones</span>
          <p class="pillar-desc">
            Acompaña al cliente en su decisión como un vendedor experto: sugiere variantes, resuelve dudas antes del pago y destraba carritos.
          </p>
          <ul class="pillar-bullets">
            <li>✓ Compara productos según necesidad del cliente.</li>
            <li>✓ Recomienda accesorios y complementos (cross-selling).</li>
            <li>✓ Genera enlaces de pago directo con promociones activas.</li>
          </ul>
        </div>

        <!-- Card 3: Automatiza internamente -->
        <div class="pillar-card" data-aos="fade-up" data-aos-delay="200">
          <div class="pillar-icon-box blue">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
            </svg>
          </div>
          <h3 class="pillar-title">Automatiza internamente</h3>
          <span class="pillar-subtitle">Pedidos, tickets, alertas y reportes</span>
          <p class="pillar-desc">
            No se queda en el chat: interactúa con tus sistemas internos para procesar órdenes, notificar al depósito y mantener sincronizada la operación.
          </p>
          <ul class="pillar-bullets">
            <li>✓ Abre tickets en Helpdesk con datos completos del caso.</li>
            <li>✓ Notifica quiebres de inventario al área de compras.</li>
            <li>✓ Actualiza estados de devolución y libera notas de crédito.</li>
          </ul>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 5. BENEFICIOS (Valor de Negocio) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="beneficios" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Impacto en Resultados</div>
        <h2 class="section-title">Beneficios para ventas, soporte y operación</h2>
        <p class="section-subtitle">
          Una solución integral diseñada para multiplicar la eficiencia del equipo sin aumentar los costos de estructura.
        </p>
      </div>

      <div class="benefits-grid">
        
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="100">
          <div class="benefit-icon-box">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <h4>Menos consultas repetitivas</h4>
          <p>Elimina hasta el 70% de las preguntas frecuentes sobre stock, envíos y medios de pago, liberando tiempo del personal.</p>
        </div>

        <div class="benefit-card" data-aos="fade-up" data-aos-delay="150">
          <div class="benefit-icon-box">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h4>Respuestas y acciones 24/7</h4>
          <p>Disponibilidad inmediata para atender a clientes nocturnos o fines de semana aplicando siempre las mismas reglas claras.</p>
        </div>

        <div class="benefit-card" data-aos="fade-up" data-aos-delay="200">
          <div class="benefit-icon-box">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h4>Mejor conversión asistida</h4>
