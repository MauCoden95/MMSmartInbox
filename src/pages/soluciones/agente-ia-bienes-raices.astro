---
import Layout from '../../layouts/Layout.astro';
import DemoModal from '../../components/DemoModal.astro';
---

<Layout
  title="Agente de IA para Bienes Raíces e Inmobiliarias | MM SmartInbox"
  description="IA que acompaña a los interesados hasta concretar una visita. Califica leads, responde consultas clave, agenda visitas y mantiene el seguimiento conectado a tu CRM e inventario."
>
  <div class="real-estate-page">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 1. HERO / BANNER -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="hero-section" id="hero">
      <div class="hero-container">
        
        <!-- Columna Izquierda: Texto y CTA -->
        <div class="hero-text-col" data-aos="fade-right">
          <div class="hero-badge">
            <span class="badge-pulse"></span>
            <span>Agente de IA para Inmobiliarias, Brokers y Desarrolladoras</span>
          </div>

          <h1 class="hero-title">
            IA que acompaña a los interesados hasta concretar una visita
          </h1>

          <p class="hero-description">
            Convierte consultas de portales, WhatsApp y redes en conversaciones útiles: el agente califica, responde dudas clave, sugiere propiedades, agenda visitas y mantiene el seguimiento para que tu equipo cierre más y persiga menos.
          </p>

          <div class="hero-actions">
            <button type="button" class="btn btn-navy" data-open-quote>
              Reservar una demo
            </button>
            <a href="#automatizaciones" class="btn btn-outline">
              Ver etapas del proceso
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>

          <!-- Microcopy de confianza -->
          <div class="hero-microcopy">
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Implementación guiada</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Integración con tu CRM</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Enfoque en operación comercial</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Flujo interactivo del Agente (Consulta → Calificación → Propiedades → Agenda visita → Seguimiento) -->
        <div class="hero-visual-col" data-aos="fade-left" data-aos-delay="150">
          <div class="flow-visual-wrapper">
            <div class="flow-glass-card">
              
              <div class="flow-card-header">
                <div class="live-indicator">
                  <span class="pulse-dot"></span>
                  <span class="live-label">Agente Inmobiliario IA Activo</span>
                </div>
                <span class="channel-pill">Portales + WhatsApp + CRM</span>
              </div>

              <!-- Pipeline de 5 etapas con íconos de marca y contexto inmobiliario -->
              <div class="flow-stream">
                
                <!-- Etapa 1: Consulta -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">1. Consulta entrante</span>
                      <span class="flow-step-meta">Zonaprop • 21:40 hs</span>
                    </div>
                    <div class="chat-bubble user-bubble">
                      "Hola, ¿sigue disponible el departamento en Palermo? ¿Aceptan mascotas y cuánto son las expensas?"
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 2: Calificación -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">2. Calificación de intención</span>
                      <span class="flow-badge-ai">IA Calificando</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>¡Hola Lucas! Sí, está disponible y <strong>es pet friendly</strong>. Expensas: <strong>$68.000</strong>. ¿Buscás mudarte en los próximos 30 días o estás evaluando opciones?</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 3: Propiedades -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                      <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">3. Match con inventario</span>
                      <span class="flow-step-meta">Conectado a inventario</span>
                    </div>
                    <div class="property-match-mini">
                      <div class="prop-thumb">🏢</div>
                      <div class="prop-details">
                        <span class="prop-title">Palermo Soho • 2 amb c/ Balcón</span>
                        <span class="prop-sub">USD 145.000 • Cochera opcional</span>
                      </div>
                      <span class="prop-badge">Match 98%</span>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 4: Agenda Visita -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">4. Agenda de visita</span>
                      <span class="flow-badge-confirmed">✓ Visita confirmada</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>¡Perfecto! Te agendé para el <strong>Jueves a las 16:30 hs</strong> con Martín, asesor de la zona. Te envié la ubicación exacta y ficha técnica por WhatsApp.</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 5: Seguimiento y CRM -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle purple-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">5. Seguimiento y CRM</span>
                      <span class="flow-step-meta">CRM Sincronizado</span>
                    </div>
                    <div class="crm-sync-box">
                      <span class="crm-tag">Lead Calificado</span>
                      <span class="crm-tag">Visita Agendada</span>
                      <span class="crm-tag">Recordatorio programado 2h antes</span>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Barra de integraciones en el pie del Hero visual -->
              <div class="flow-systems-bar">
                <span class="systems-label">Sincronizado con:</span>
                <span class="system-tag">Tokko Broker</span>
                <span class="system-tag">WhatsApp API</span>
                <span class="system-tag">Google Calendar</span>
                <span class="system-tag">Zonaprop / Portales</span>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 2. EL PROBLEMA (Identificación de situaciones reales) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="problema" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">El Reto de la Operación Inmobiliaria</div>
        <h2 class="section-title">Cuando llegan consultas, el cuello de botella es el seguimiento</h2>
        <p class="section-subtitle">
          Invertir en portales y pauta digital genera volumen de contactos, pero la respuesta manual y la falta de calificación terminan dispersando las oportunidades de cierre.
        </p>
      </div>

      <div class="problem-grid">
        
        <!-- Problema 1 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="100">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Leads preguntando lo mismo y la respuesta llega tarde</h3>
            <p>Precio, expensas, ubicación precisa y requisitos de ingreso. Cuando un asesor tarda horas en contestar, el interesado ya consultó en tres inmobiliarias más.</p>
          </div>
        </div>

        <!-- Problema 2 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="150">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Consultas fuera de horario que se enfrían</h3>
            <p>La mayor parte de los compradores e inquilinos buscan propiedades por la noche y fines de semana. Si no hay respuesta inmediata, ese contacto se pierde.</p>
          </div>
        </div>

        <!-- Problema 3 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="200">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7" r="4"></circle>
              <line x1="18" y1="8" x2="23" y2="13"></line>
              <line x1="23" y1="8" x2="18" y2="13"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Leads sin calificar que consumen tiempo del equipo</h3>
            <p>Asesores comerciales dedicando horas valiosas a coordinar visitas con personas que no cuentan con el presupuesto, la garantía requerida o urgencia real.</p>
          </div>
        </div>

        <!-- Problema 4 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="250">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Agendas desordenadas: idas y vueltas por chat</h3>
            <p>Coordinar día y hora por mensajes cruzados genera cancelaciones de último momento, ausencias en visitas fijadas y huecos improductivos en el calendario.</p>
          </div>
        </div>

        <!-- Problema 5 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="300">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Falta de registro: nadie sabe en qué etapa está cada uno</h3>
            <p>Conversaciones que quedan en los WhatsApp personales de cada vendedor sin sincronizarse con el CRM, impidiendo tener visibilidad de la cartera comercial.</p>
          </div>
        </div>

        <!-- Problema 6 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="350">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path>
              <line x1="12" y1="2" x2="12" y2="12"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Seguimientos olvidados que enfrían operaciones</h3>
            <p>Tras una primera visita o consulta inicial, el asesor no recontacta a tiempo. Operaciones con alto potencial de cierre se apagan por falta de cadencia comercial.</p>
          </div>
        </div>

      </div>

      <!-- Cierre destacado de la sección -->
      <div class="problem-closing-banner" data-aos="fade-up">
        <div class="closing-banner-inner">
          <div class="closing-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <p class="closing-text">
            <strong>La IA no reemplaza a tu equipo:</strong> elimina tareas repetitivas para que tus asesores se enfoquen en negociar, mostrar inmuebles y cerrar operaciones.
          </p>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 3. QUÉ HACE UN AGENTE DE IA (Comparativa Chatbot vs Agente) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container bg-subtle" id="que-hace" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Evolución Tecnológica</div>
        <h2 class="section-title">Más que responder: entiende, decide y ejecuta</h2>
        <p class="section-subtitle">
          Un chatbot convencional se limita a mostrar botones o textos pregrabados. Un Agente de IA para Real Estate razona con contexto, consulta tu inventario disponible y avanza el trámite en tu CRM.
        </p>
      </div>

      <div class="comparison-grid">
        
        <!-- Card 1: Chatbot convencional -->
        <div class="comp-card bot-card" data-aos="fade-up" data-aos-delay="100">
          <div class="comp-header">
            <span class="comp-type-badge basic">Enfoque Limitado</span>
            <h3 class="comp-title">Chatbot tradicional</h3>
            <p class="comp-tagline">Responde preguntas aisladas</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>Menús rígidos con opciones numéricas ("Marca 1 para ventas, 2 para alquiler").</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>Respuestas estáticas de texto sin verificar si la propiedad sigue disponible.</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>No comprende preguntas complejas ("Busco 3 amb con balcón aterrazado y apto crédito").</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>No agenda turnos ni actualiza la ficha del cliente en el CRM.</span>
            </li>
          </ul>
        </div>

        <!-- Card 2: Agente IA - Entiende intención -->
        <div class="comp-card agent-card featured" data-aos="fade-up" data-aos-delay="200">
          <div class="comp-badge-recommended">Inteligencia y Contexto</div>
          <div class="comp-header">
            <span class="comp-type-badge premium">Agente de IA</span>
            <h3 class="comp-title">Entiende intención y contexto</h3>
            <p class="comp-tagline">Perfil, presupuesto, zona y urgencia</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Interpreta lenguaje natural en audio y texto sin obligar al usuario a elegir botones.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Recuerda el historial de la charla y las preferencias particulares del comprador.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Identifica el nivel de urgencia, motivo de búsqueda y capacidad financiera real.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Adapta el tono de comunicación a la identidad de tu inmobiliaria o desarrollo.</span>
            </li>
          </ul>
        </div>

        <!-- Card 3: Agente IA - Ejecuta acciones -->
        <div class="comp-card agent-card action" data-aos="fade-up" data-aos-delay="300">
          <div class="comp-badge-recommended action-badge">Capacidad Operativa</div>
          <div class="comp-header">
            <span class="comp-type-badge accent">Agente de IA</span>
            <h3 class="comp-title">Ejecuta acciones comerciales</h3>
            <p class="comp-tagline">Califica, agenda, registra y deriva</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Consulta inventario de propiedades en tiempo real (precio, estado y expensas).</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Resuelve dudas sobre políticas, garantías aceptadas, anticipos y plazos de entrega.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Cruza la disponibilidad de la agenda del asesor y fija la cita de visita sin fricción.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Crea el lead en el CRM inmobiliario con notas completas y dispara recordatorios.</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Texto simple complementario -->
      <div class="what-it-does-summary" data-aos="fade-up">
        <p>
          El agente puede <strong>consultar inventario de propiedades</strong> en vivo, <strong>explicar políticas y requisitos</strong>, <strong>verificar disponibilidad de agenda</strong> y <strong>actualizar tu CRM</strong> de forma autónoma en cada conversación.
        </p>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 4. BENEFICIOS PARA LA OPERACIÓN COMERCIAL -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="beneficios" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Impacto en el Negocio</div>
        <h2 class="section-title">Beneficios para tu operación comercial</h2>
        <p class="section-subtitle">
          Diseñado para que brokers independientes, inmobiliarias consolidadas y desarrolladoras escalen su atención sin inflar costos fijos.
        </p>
      </div>

      <div class="benefits-grid">
        
        <!-- Beneficio 1 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="100">
          <div class="benefit-icon-wrapper blue-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3>Respuesta inmediata 24/7 a consultas entrantes</h3>
          <p>
            Atención instantánea a interesados de Zonaprop, Argenprop, Instagram y WhatsApp, incluso domingos a medianoche o días feriados.
          </p>
        </div>

        <!-- Beneficio 2 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="150">
          <div class="benefit-icon-wrapper green-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3>Calificación automática y precisa</h3>
          <p>
            Identifica presupuesto, zona deseada, ambientes requeridos, plazos de mudanza y motivo de compra antes de pasar el lead a un asesor.
          </p>
        </div>

        <!-- Beneficio 3 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="200">
          <div class="benefit-icon-wrapper blue-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
