---
import Layout from '../../layouts/Layout.astro';
import DemoModal from '../../components/DemoModal.astro';
---

<Layout
  title="Agente de IA para Logística, Envíos y Operaciones | MM SmartInbox"
  description="IA que mantiene tus envíos en movimiento y tu operación ordenada. Automatiza tracking, gestión de incidencias, remitos POD y tareas internas conectado a tu TMS, WMS y ERP."
>
  <div class="logistics-page">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 1. HERO / BANNER -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="hero-section" id="hero">
      <div class="hero-container">
        
        <!-- Columna Izquierda: Texto y CTA -->
        <div class="hero-text-col" data-aos="fade-right">
          <div class="hero-badge">
            <span class="badge-pulse"></span>
            <span>Agente de IA para Operadores Logísticos, Última Milla y Distribución</span>
          </div>

          <h1 class="hero-title">
            IA que mantiene tus envíos en movimiento y tu operación ordenada
          </h1>

          <p class="hero-description">
            Automatiza tareas internas y comunicaciones de estado en un flujo continuo: el agente consulta tracking, actualiza sistemas, clasifica incidencias, crea tickets, dispara alertas y deriva casos críticos. Menos trabajo repetitivo, más control operativo.
          </p>

          <div class="hero-actions">
            <button type="button" class="btn btn-navy" data-open-quote>
              Reservar una demo
            </button>
            <a href="#automatizaciones" class="btn btn-outline">
              Ver flujos operativos
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>

          <!-- Microcopy de confianza -->
          <div class="hero-microcopy">
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Implementación guiada</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Integración con TMS / WMS / ERP</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Automatización interna + atención al cliente</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Diagrama en 2 carriles (Canales Cliente <-> Orquestador IA <-> Operación Interna) -->
        <div class="hero-visual-col" data-aos="fade-left" data-aos-delay="150">
          <div class="flow-visual-wrapper">
            <div class="flow-glass-card">
              
              <div class="flow-card-header">
                <div class="live-indicator">
                  <span class="pulse-dot"></span>
                  <span class="live-label">Agente Logístico Orquestador</span>
                </div>
                <span class="channel-pill">TMS • WMS • WhatsApp • ERP</span>
              </div>

              <!-- Pipeline de Integración Operativa en 2 carriles -->
              <div class="flow-stream">
                
                <!-- Etapa 1: Consulta Cliente -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">Carril Cliente • Consulta</span>
                      <span class="flow-step-meta">WhatsApp Business • 11:20 hs</span>
                    </div>
                    <div class="chat-bubble user-bubble">
                      "Hola! ¿A qué hora llega mi envío #LOG-4921 a Córdoba? Estaba previsto para la mañana."
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 2: Orquestación y Consulta TMS en Vivo -->
                <div class="flow-step-item highlight-ai">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">Orquestador IA • Cruce de Datos</span>
                      <span class="flow-badge-ai">SLA Validado en TMS ✓</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>El móvil está en tu zona (Parada 4). Tu nueva ventana confirmada es de <strong>14:30 a 16:00 hs</strong>. ¿Confirmás recepción en el domicilio registrado?</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 3: Acción Interna Automática (Backoffice) -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle purple-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                      <line x1="8" y1="21" x2="16" y2="21"></line>
                      <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">Operación Interna • Automatización</span>
                      <span class="flow-step-meta">Backoffice Sincronizado</span>
                    </div>
                    <div class="crm-sync-box">
                      <span class="crm-tag">Ticket #8402 Helpdesk abierto</span>
                      <span class="crm-tag">Asignado a: Base Córdoba</span>
                      <span class="crm-tag">TMS: 'Demora informada'</span>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 4: Cierre con Evidencia (POD) -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">Cierre de Entrega • POD Digital</span>
                      <span class="flow-badge-confirmed">Entrega Exitosa ✓</span>
                    </div>
                    <div class="property-match-mini">
                      <div class="prop-thumb">📦</div>
                      <div class="prop-details">
                        <span class="prop-title">Firma digital + Foto recibida</span>
                        <span class="prop-sub">Remito archivado en WMS • Pre-facturación ERP lista</span>
                      </div>
                      <span class="prop-badge">Completado</span>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Barra de integraciones en el pie del Hero visual -->
              <div class="flow-systems-bar">
                <span class="systems-label">Sincronizado con:</span>
                <span class="system-tag">TMS Propio/SaaS</span>
                <span class="system-tag">WMS Almacén</span>
                <span class="system-tag">SAP / ERP</span>
                <span class="system-tag">Helpdesk / Tickets</span>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 2. NO ES UN CHATBOT: ES AUTOMATIZACIÓN OPERATIVA -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="diferenciacion" data-aos="fade-up">
      <div class="operational-banner">
        <div class="operational-banner-header text-center">
          <div class="section-badge">Impacto en el Núcleo del Negocio</div>
          <h2 class="section-title">
            Atención al cliente es solo una parte.<br>El mayor impacto está dentro de la operación.
          </h2>
          <p class="section-subtitle">
            Un chatbot convencional se limita a responder preguntas con texto estático. Un Agente de IA para Logística consulta bases de datos, decide mediante reglas de negocio y ejecuta acciones concretas dentro de tus herramientas de backoffice.
          </p>
        </div>

        <div class="operational-actions-grid">
          
          <div class="op-action-item" data-aos="fade-up" data-aos-delay="100">
            <div class="op-action-icon blue">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
              </svg>
            </div>
            <div class="op-action-text">
              <h4>Actualiza estados</h4>
              <p>Sincroniza en tiempo real eventos de choferes y carriers hacia el TMS, ERP o CRM.</p>
            </div>
          </div>

          <div class="op-action-item" data-aos="fade-up" data-aos-delay="150">
            <div class="op-action-icon green">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <div class="op-action-text">
              <h4>Crea tareas y tickets</h4>
              <p>Abre casos en Helpdesk o Jira ante incidencias y los asigna al despachante zonal.</p>
            </div>
          </div>

          <div class="op-action-item" data-aos="fade-up" data-aos-delay="200">
            <div class="op-action-icon blue">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
            </div>
            <div class="op-action-text">
              <h4>Notifica por excepción</h4>
              <p>Alerta proactivamente a supervisores antes de que venza un SLA contractual.</p>
            </div>
          </div>

          <div class="op-action-item" data-aos="fade-up" data-aos-delay="250">
            <div class="op-action-icon green">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
              </svg>
            </div>
            <div class="op-action-text">
              <h4>Registra evidencias POD</h4>
              <p>Recaba remitos firmados y fotos de entrega, archivándolos automáticamente.</p>
            </div>
          </div>

          <div class="op-action-item" data-aos="fade-up" data-aos-delay="300">
            <div class="op-action-icon blue">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </div>
            <div class="op-action-text">
              <h4>Genera reportes operativos</h4>
              <p>Consolida resúmenes de causas de desvío, volumetría y tiempos de ciclo.</p>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 3. PROBLEMAS REALES (Fricción externa e interna) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container bg-subtle" id="problemas" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">El Desafío de la Cadena Logística</div>
        <h2 class="section-title">Cuando el volumen crece, la fricción interna y externa se dispara</h2>
        <p class="section-subtitle">
          El tiempo de tus operadores se disuelve entre contestar reclamos repetitivos y actualizar manualmente múltiples sistemas desconectados.
        </p>
      </div>

      <div class="problem-grid">
        
        <!-- Problema 1 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="100">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>“¿Dónde está mi envío?” saturando soporte</h3>
            <p>Cientos de consultas diarias por WhatsApp y correo pidiendo estados de tracking que el personal busca manualmente copiando y pegando guías.</p>
          </div>
        </div>

        <!-- Problema 2 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="150">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Seguimiento manual entre planillas y portales</h3>
            <p>Operadores cruzando información entre webs de transportistas terceros, planillas de cálculo y el sistema central sin una vista unificada.</p>
          </div>
        </div>

        <!-- Problema 3 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="200">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Incidencias repetidas sin flujo estándar</h3>
            <p>Direcciones con numeración incompleta, timbre roto o ausencias del receptor tratadas caso a caso sin reglas automáticas de reintento o aviso.</p>
          </div>
        </div>

        <!-- Problema 4 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="250">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Actualización tardía de estados en TMS/ERP</h3>
            <p>Entregas y fallos que se cargan horas o días después, provocando que los clientes vean información desfasada y desconfíen del servicio.</p>
          </div>
        </div>

        <!-- Problema 5 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="300">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Falta de trazabilidad: chat → ticket → solución</h3>
            <p>Conversaciones con clientes que mueren en el WhatsApp del operador sin transformarse en un ticket estructurado ni quedar registradas en el legajo del envío.</p>
          </div>
        </div>

        <!-- Problema 6 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="350">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <path d="M12 18v-6"></path>
              <path d="M9 15l3 3 3-3"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Horas perdidas en tareas de remitos y POD</h3>
            <p>Búsqueda manual de comprobantes firmados, conciliación de guías entregadas contra facturación y resolución de reclamos por demoras administrativas.</p>
          </div>
        </div>

      </div>

      <!-- Cierre destacado de la sección -->
      <div class="problem-closing-banner" data-aos="fade-up">
        <div class="closing-banner-inner">
          <div class="closing-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <p class="closing-text">
            <strong>La solución no es contratar más operadores para cargar planillas:</strong> es automatizar los flujos entre los canales de contacto y tus sistemas de gestión.
          </p>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 4. QUÉ HACE UN AGENTE DE IA EN LOGÍSTICA (3 Roles) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="que-hace" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Capacidades del Sistema</div>
        <h2 class="section-title">Entiende contexto y ejecuta acciones conectadas</h2>
        <p class="section-subtitle">
          El agente opera como un asistente digital para tus clientes y como un orquestador automatizado para tu equipo de operaciones.
        </p>
      </div>

      <div class="comparison-grid">
        
        <!-- Card 1: Responde -->
        <div class="comp-card bot-card" data-aos="fade-up" data-aos-delay="100">
          <div class="comp-header">
            <span class="comp-type-badge basic">Canal Exterior</span>
            <h3 class="comp-title">Responde y guía</h3>
            <p class="comp-tagline">Consultas de tracking y estados</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Informa estados de guía, franjas horarias y eventos de entrega en tiempo real.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Resuelve dudas sobre cobertura de zonas, requisitos de despacho y embalaje.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Permite al receptor validar su dirección y confirmar si estará en el domicilio.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Atiende 24/7 por WhatsApp, web chat y correo sin tiempos de espera.</span>
            </li>
          </ul>
        </div>

        <!-- Card 2: Orquesta -->
        <div class="comp-card agent-card featured" data-aos="fade-up" data-aos-delay="200">
          <div class="comp-badge-recommended">Inteligencia y SLA</div>
          <div class="comp-header">
            <span class="comp-type-badge premium">Orquestador IA</span>
            <h3 class="comp-title">Orquesta y decide</h3>
            <p class="comp-tagline">Cruce de carriers y reglas operativas</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Cruza información entre múltiples transportistas y tu base de datos central.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Monitorea tiempos de tránsito y detecta envíos con riesgo de incumplimiento de SLA.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Clasifica la severidad de un reclamo según el tipo de cliente (cuenta B2B vs. usuario final).</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Aplica reglas de reintento de entrega antes de que el bulto vuelva a depósito.</span>
            </li>
          </ul>
        </div>

        <!-- Card 3: Automatiza internamente -->
        <div class="comp-card agent-card action" data-aos="fade-up" data-aos-delay="300">
          <div class="comp-badge-recommended action-badge">Impacto en Backoffice</div>
          <div class="comp-header">
            <span class="comp-type-badge accent">Operación Interna</span>
            <h3 class="comp-title">Automatiza internamente</h3>
            <p class="comp-tagline">Tickets, actualización de TMS y alertas</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Abre tickets en Helpdesk o Jira con todos los datos precargados y clasificados.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Actualiza hitos en tu TMS/ERP automáticamente sin carga manual de operadores.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Dispara alertas internas a supervisores cuando una unidad sufre demoras críticas.</span>
