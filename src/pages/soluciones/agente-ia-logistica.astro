  /* ============================================================== */
  /* 2. NO ES UN CHATBOT: AUTOMATIZACIÓN OPERATIVA                  */
  /* ============================================================== */
  .operational-banner {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 3rem 2.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .operational-actions-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .op-action-item {
    background: #f8fafc;
