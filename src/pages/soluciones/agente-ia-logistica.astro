    color: #334155;
  }

  .check-icon {
    font-weight: 800;
    color: #15C63B;
    flex-shrink: 0;
  }

  /* ============================================================== */
  /* 5. AUTOMATIZACIONES INTERNAS (Backoffice 8 Cards Grid)         */
  /* ============================================================== */
  .backoffice-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .backoffice-card {
    background: #ffffff;
