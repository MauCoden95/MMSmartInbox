  }

  .backoffice-icon-wrap.green {
    background: rgba(21, 198, 59, 0.12);
    color: #15C63B;
  }

  .backoffice-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
  }

  .backoffice-card p {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.55;
  }

  .integration-notice-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.25rem 1.75rem;
