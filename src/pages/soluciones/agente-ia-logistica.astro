    border-color: #e2e8f0;
  }

  .comp-card.featured {
    border: 2px solid #0b2591;
    box-shadow: 0 12px 30px -5px rgba(11, 37, 145, 0.15);
  }

  .comp-card.action {
    border: 2px solid #15C63B;
    box-shadow: 0 12px 30px -5px rgba(21, 198, 59, 0.15);
  }

  .comp-badge-recommended {
