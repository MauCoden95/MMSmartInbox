    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .notice-content {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.55;
  }

  .notice-content strong {
    color: #0b2591;
  }

  /* ============================================================== */
  /* 6. CICLO DEL ENVÍO (Dual Lane Cards & Tabs)                    */
  /* ============================================================== */
  .process-tabs-container {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    margin-bottom: 3.5rem;
  }

  .process-tabs-nav {
    display: flex;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    overflow-x: auto;
  }

  .process-tab-btn {
    flex: 1;
    min-width: 170px;
    padding: 1.1rem 1rem;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
  }

  .process-tab-btn:hover {
    background: #f1f5f9;
  }

  .process-tab-btn.is-active {
    background: #ffffff;
    border-bottom-color: #0b2591;
  }

  .tab-number {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #475569;
    font-size: 0.78rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .process-tab-btn.is-active .tab-number {
    background: #0b2591;
    color: #ffffff;
  }

  .tab-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #475569;
    white-space: nowrap;
  }

  .process-tab-btn.is-active .tab-label {
    color: #0b2591;
  }

  .process-tabs-content {
    padding: 2.5rem;
  }

  .process-tab-panel {
    display: none;
  }

  .process-tab-panel.is-active {
    display: block;
    animation: fadeInTab 0.3s ease forwards;
  }

  @keyframes fadeInTab {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .panel-dual-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .dual-lane-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .dual-lane-card.external {
    border-left: 4px solid #0b2591;
  }

  .dual-lane-card.internal {
    border-left: 4px solid #15C63B;
  }

  .dual-lane-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .lane-tag {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #0b2591;
  }

  .lane-tag.green {
    color: #0c8a26;
  }

  .dual-lane-header h4 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
  }

  .lane-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .lane-checklist li {
    font-size: 0.92rem;
    color: #334155;
    line-height: 1.5;
  }

  .lane-checklist li strong {
    color: #0f172a;
  }

  /* Bloque: Escala a un humano cuando... */
  .human-escalation-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2.25rem;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
  }

  .escalation-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .escalation-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #0b2591;
    background: rgba(11, 37, 145, 0.08);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
