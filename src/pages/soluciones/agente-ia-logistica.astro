  .escalation-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  .escalation-subtitle {
    font-size: 0.95rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
  }

  .escalation-cases-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .escalation-case-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    position: relative;
    transition: all 0.2s ease;
  }

  .escalation-case-card:hover {
    border-color: #cbd5e1;
    background: #ffffff;
  }

  .case-number {
    font-size: 1.35rem;
    font-weight: 900;
    color: rgba(11, 37, 145, 0.25);
    margin-bottom: 0.4rem;
  }

  .escalation-case-card h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
    margin-bottom: 0.5rem;
  }

  .escalation-case-card p {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.5;
  }

  /* ============================================================== */
  /* 7. INTEGRACIONES                                               */
