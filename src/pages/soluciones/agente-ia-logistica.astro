    padding: 1.5rem 2rem;
  }

  .closing-banner-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .closing-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #0b2591;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .closing-text {
    font-size: 1.05rem;
    color: #1e293b;
    line-height: 1.6;
  }

  .closing-text strong {
    color: #0b2591;
  }

  /* ============================================================== */
  /* 4. COMPARATIVA (Qué hace el agente)                            */
  /* ============================================================== */
  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: 2rem;
  }

  .comp-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .comp-card.bot-card {
