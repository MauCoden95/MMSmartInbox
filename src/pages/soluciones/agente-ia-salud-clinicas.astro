---
import Layout from '../../layouts/Layout.astro';
import DemoModal from '../../components/DemoModal.astro';
---

<Layout
  title="Agente de IA para Salud y Clínicas | MM SmartInbox"
  description="IA que mejora la atención al paciente sin saturar a tu equipo. Automatiza admisión, turnos, recordatorios, preconsulta y postconsulta conectada a tu agenda médica y sistemas de gestión."
>
  <div class="health-page">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 1. HERO / BANNER -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="hero-section" id="hero">
      <div class="hero-container">
        
        <!-- Columna Izquierda: Texto y CTA -->
        <div class="hero-text-col" data-aos="fade-right">
          <div class="hero-badge">
            <span class="badge-pulse"></span>
            <span>Agente de IA para Clínicas, Consultorios y Centros Médicos</span>
          </div>

          <h1 class="hero-title">
            IA que mejora la atención al paciente sin saturar a tu equipo
          </h1>

          <p class="hero-description">
            Transforma la admisión, la gestión de turnos y el seguimiento posterior en un flujo ordenado de asistencia. El agente responde dudas frecuentes, guía trámites, agenda y recuerda turnos, y deriva casos sensibles al personal, para que tu clínica atienda mejor con menos esfuerzo repetitivo.
          </p>

          <div class="hero-actions">
            <button type="button" class="btn btn-navy" data-open-quote>
              Reservar una demo
            </button>
            <a href="#automatizaciones" class="btn btn-outline">
              Ver recorrido del paciente
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>

          <!-- Microcopy de confianza -->
          <div class="hero-microcopy">
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Implementación guiada</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Privacidad por diseño</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Integración con tu agenda y sistemas</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Flujo interactivo del Paciente (Consulta → Turno → Preconsulta → Atención → Postconsulta) -->
        <div class="hero-visual-col" data-aos="fade-left" data-aos-delay="150">
          <div class="flow-visual-wrapper">
            <div class="flow-glass-card">
              
              <div class="flow-card-header">
                <div class="live-indicator">
                  <span class="pulse-dot"></span>
                  <span class="live-label">Agente de Salud IA Activo</span>
                </div>
                <span class="channel-pill">WhatsApp • Agenda Médica • Encriptado</span>
              </div>

              <!-- Pipeline de 5 etapas del Paciente -->
              <div class="flow-stream">
                
                <!-- Etapa 1: Consulta -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">1. Consulta y Admisión</span>
                      <span class="flow-step-meta">WhatsApp • 10:15 hs</span>
                    </div>
                    <div class="chat-bubble user-bubble">
                      "Hola! ¿Tienen turnos para Dermatología en Sede Centro? ¿Atienden con OSDE 210?"
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 2: Turno y Disponibilidad -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">2. Asignación de Turno</span>
                      <span class="flow-badge-ai">Agenda Sincronizada ✓</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>¡Hola Carla! Sí, el Dr. Gómez atiende en Sede Centro con tu cobertura. Tenemos turnos libres este <strong>Jueves a las 15:30 hs</strong> o <strong>Viernes a las 11:00 hs</strong>. ¿Cuál te queda más cómodo?</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 3: Preconsulta y Preparación -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">3. Preconsulta / Recordatorio</span>
                      <span class="flow-step-meta">24 hs antes del turno</span>
                    </div>
                    <div class="property-match-mini">
                      <div class="prop-thumb">📋</div>
                      <div class="prop-details">
                        <span class="prop-title">Turno confirmado • Jueves 15:30 hs</span>
                        <span class="prop-sub">Recordatorio de DNI, credencial y copago digital</span>
                      </div>
                      <span class="prop-badge">Confirmado</span>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 4: Atención / Soporte en Sede -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">4. Durante la atención</span>
                      <span class="flow-badge-confirmed">Check-in Guiado</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>Te esperamos en <strong>Av. Santa Fe 2400 (Piso 2, Consultorio 6)</strong>. Podés hacer check-in directo en recepción con tu DNI. Hay estacionamiento a 50m.</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 5: Postconsulta y Seguimiento -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle purple-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">5. Postconsulta</span>
                      <span class="flow-step-meta">Seguimiento y Trámites</span>
                    </div>
                    <div class="crm-sync-box">
                      <span class="crm-tag">Certificado disponible</span>
                      <span class="crm-tag">Control programado 30d</span>
                      <span class="crm-tag">Encuesta 5★</span>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Barra de integraciones en el pie del Hero visual -->
              <div class="flow-systems-bar">
                <span class="systems-label">Sincronizado con:</span>
                <span class="system-tag">Sistema de Turnos</span>
                <span class="system-tag">WhatsApp API</span>
                <span class="system-tag">Historia Clínica / EMR</span>
                <span class="system-tag">Google Calendar</span>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 2. EL PROBLEMA (Cuando suben las consultas, el cuello de botella es administrativo) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="problema" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">El Reto de la Gestión Médica</div>
        <h2 class="section-title">Cuando suben las consultas, el cuello de botella es administrativo</h2>
        <p class="section-subtitle">
          Entre atender el teléfono de turnos, responder mensajes por redes y recibir a los pacientes en sala de espera, la recepción se desborda y la experiencia de atención se resiente.
        </p>
      </div>

      <div class="problem-grid">
        
        <!-- Problema 1 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="100">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Pacientes esperando respuesta por WhatsApp y redes</h3>
            <p>Consultas acumuladas en el chat oficial fuera de horario o en picos de demanda que generan frustración y hacen que el paciente busque otro centro médico.</p>
          </div>
        </div>

        <!-- Problema 2 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="150">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Turnos mal gestionados: idas y vueltas constantes</h3>
            <p>Múltiples mensajes para coordinar una fecha y hora disponible, reprogramaciones manuales desordenadas y huecos improductivos en las agendas de los profesionales.</p>
          </div>
        </div>

        <!-- Problema 3 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="200">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Preguntas idénticas repetidas decenas de veces</h3>
            <p>Dudas sobre coberturas, obras sociales aceptadas, horarios, sedes, documentación exigida e instrucciones previas para estudios (como horas de ayuno).</p>
          </div>
        </div>

        <!-- Problema 4 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="250">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path>
              <line x1="12" y1="2" x2="12" y2="12"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>No-shows por falta de confirmaciones oportunas</h3>
            <p>Pacientes que no asisten a su consulta programada porque no recibieron un recordatorio con botón de confirmación, perjudicando el tiempo del médico.</p>
          </div>
        </div>

        <!-- Problema 5 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="300">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Recepción interrumpida frente al paciente presente</h3>
            <p>El personal atiende llamadas o responde mensajes mientras un paciente en persona espera ser admitido en el mostrador, degradando la calidez del servicio.</p>
          </div>
        </div>

        <!-- Problema 6 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="350">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Información fragmentada entre sistemas y planillas</h3>
            <p>Datos dispersos en chats individuales, planillas de Excel, agendas paralelas y software clínico sin sincronización, provocando duplicidad y errores.</p>
          </div>
        </div>

      </div>

      <!-- Cierre destacado de la sección -->
      <div class="problem-closing-banner" data-aos="fade-up">
        <div class="closing-banner-inner">
          <div class="closing-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <p class="closing-text">
            <strong>La IA no reemplaza al personal de salud:</strong> automatiza lo repetitivo para cuidar la experiencia del paciente.
          </p>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 3. QUÉ HACE UN AGENTE DE IA EN CLÍNICAS (Comparativa) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container bg-subtle" id="que-hace" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Evolución Tecnológica en Salud</div>
        <h2 class="section-title">Más que responder: entiende, decide y ejecuta con reglas</h2>
        <p class="section-subtitle">
          Un chatbot convencional se limita a mostrar un menú estático. Un Agente de IA para Clínicas comprende la necesidad del paciente, aplica reglas de negocio y gestiona la agenda en tiempo real.
        </p>
      </div>

      <div class="comparison-grid">
        
        <!-- Card 1: Chatbot tradicional -->
        <div class="comp-card bot-card" data-aos="fade-up" data-aos-delay="100">
          <div class="comp-header">
            <span class="comp-type-badge basic">Enfoque Limitado</span>
            <h3 class="comp-title">Chatbot tradicional</h3>
            <p class="comp-tagline">Responde FAQs aisladas</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>Menús rígidos ("Marca 1 para turnos, 2 para horarios, 3 para médicos").</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>Textos prearmados sin verificar si el profesional realmente tiene espacio libre.</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>No comprende consultas combinadas ("Necesito ecografía abdominal y turno clínico el mismo día").</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>No distingue entre una consulta administrativa y un motivo de urgencia.</span>
            </li>
          </ul>
        </div>

        <!-- Card 2: Agente IA - Entiende intención y contexto -->
        <div class="comp-card agent-card featured" data-aos="fade-up" data-aos-delay="200">
          <div class="comp-badge-recommended">Inteligencia y Contexto</div>
          <div class="comp-header">
            <span class="comp-type-badge premium">Agente de IA</span>
            <h3 class="comp-title">Entiende intención y contexto</h3>
            <p class="comp-tagline">Especialidad, cobertura, sede y urgencia</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Interpreta lenguaje natural en texto y audio con tono empático y respetuoso.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Identifica especialidad correcta, cobertura u obra social y sede de preferencia.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Distingue consultas habituales de síntomas que requieren derivación urgente.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Recuerda el historial administrativo y las indicaciones previas del paciente.</span>
            </li>
          </ul>
        </div>

        <!-- Card 3: Agente IA - Ejecuta acciones -->
        <div class="comp-card agent-card action" data-aos="fade-up" data-aos-delay="300">
          <div class="comp-badge-recommended action-badge">Capacidad Operativa</div>
          <div class="comp-header">
            <span class="comp-type-badge accent">Agente de IA</span>
            <h3 class="comp-title">Ejecuta acciones operativas</h3>
            <p class="comp-tagline">Agenda, confirma, registra y deriva</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Consulta disponibilidad de turnos en vivo en el sistema de gestión o calendario.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Asigna turnos, envía recordatorios y gestiona reprogramaciones con reglas claras.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Informa preparaciones para estudios médicos (ayuno, recetas, órdenes).</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Registra datos administrativos en el CRM/EMR y deriva a un operador cuando corresponde.</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Texto simple complementario -->
      <div class="what-it-does-summary" data-aos="fade-up">
        <p>
          El agente puede <strong>conectarse a tu agenda, CRM o sistema de turnos</strong> para evitar errores, prevenir superposiciones y mantener el orden en cada consulta.
        </p>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 4. BENEFICIOS (Para la clínica y para el paciente) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="beneficios" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Impacto en la Atención</div>
        <h2 class="section-title">Beneficios para la clínica y para el paciente</h2>
        <p class="section-subtitle">
          Diseñado para centros médicos, consultorios y clínicas que buscan optimizar sus procesos sin comprometer la calidez en el trato humano.
        </p>
      </div>

      <div class="benefits-grid">
        
        <!-- Beneficio 1 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="100">
          <div class="benefit-icon-wrapper blue-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3>Respuestas rápidas y consistentes 24/7</h3>
          <p>
            Atención al instante en cualquier momento del día, brindando información certera sobre turnos, profesionales y requisitos de atención.
          </p>
        </div>

        <!-- Beneficio 2 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="150">
          <div class="benefit-icon-wrapper green-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3>Menos carga en recepción por consultas repetitivas</h3>
          <p>
            Libera al personal de llamadas y mensajes monótonos para que puedan brindar una atención cálida y personalizada en el mostrador.
          </p>
        </div>

        <!-- Beneficio 3 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="200">
          <div class="benefit-icon-wrapper blue-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
