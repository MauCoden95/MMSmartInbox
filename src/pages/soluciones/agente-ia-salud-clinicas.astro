  /* 5. TABS DE AUTOMATIZACIONES Y RECORRIDO                        */
  /* ============================================================== */
  .process-tabs-container {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    margin-bottom: 3.5rem;
  }

  .process-tabs-nav {
    display: flex;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    overflow-x: auto;
  }

  .process-tab-btn {
    flex: 1;
    min-width: 170px;
    padding: 1.1rem 1rem;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
  }

  .process-tab-btn:hover {
    background: #f1f5f9;
  }

  .process-tab-btn.is-active {
    background: #ffffff;
    border-bottom-color: #0b2591;
  }

  .tab-number {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #475569;
    font-size: 0.78rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .process-tab-btn.is-active .tab-number {
    background: #0b2591;
    color: #ffffff;
  }

  .tab-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #475569;
    white-space: nowrap;
  }

  .process-tab-btn.is-active .tab-label {
    color: #0b2591;
  }

  .process-tabs-content {
    padding: 2.5rem;
  }

  .process-tab-panel {
    display: none;
  }

  .process-tab-panel.is-active {
    display: block;
    animation: fadeInTab 0.3s ease forwards;
  }

  @keyframes fadeInTab {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .panel-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
  }

  .panel-badge-step {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #0b2591;
    background: rgba(11, 37, 145, 0.08);
    padding: 0.25rem 0.7rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }

  .panel-text h3 {
    font-size: 1.7rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .panel-desc {
    font-size: 1rem;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .panel-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .panel-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.94rem;
    color: #334155;
    line-height: 1.5;
  }

  .check-circ {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(21, 198, 59, 0.15);
    color: #15C63B;
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Chat Mockup in Tabs */
  .chat-mockup-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
  }

  .mockup-header {
    background: #ffffff;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .mockup-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .mockup-dot.red { background-color: #ef4444; }
  .mockup-dot.yellow { background-color: #f59e0b; }
  .mockup-dot.green { background-color: #10b981; }

  .mockup-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #475569;
    margin-left: 0.4rem;
  }

  .mockup-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .m-msg {
    font-size: 0.85rem;
    line-height: 1.45;
    padding: 0.65rem 0.9rem;
    border-radius: 10px;
    max-width: 90%;
  }

  .m-msg.user {
    background: #e2e8f0;
    color: #1e293b;
    align-self: flex-start;
    border-bottom-left-radius: 2px;
  }

  .m-msg.ai {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #0f172a;
    align-self: flex-end;
    border-bottom-right-radius: 2px;
  }

  .m-sender {
    display: block;
    font-size: 0.68rem;
    font-weight: 800;
    color: #0b2591;
    margin-bottom: 0.25rem;
  }

  .m-meta-pill {
    background: rgba(21, 198, 59, 0.12);
    color: #15C63B;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    text-align: center;
    margin-top: 0.25rem;
  }

  .m-meta-pill.accent {
    background: rgba(234, 88, 12, 0.12);
    color: #ea580c;
  }

  /* Medical Safety Box */
  .medical-safety-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 2.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .safety-banner-top {
    text-align: center;
    padding-bottom: 2rem;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 2rem;
  }

  .safety-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #dc2626;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 0.85rem;
  }

  .safety-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }

  .safety-desc {
    font-size: 1rem;
    color: #475569;
    line-height: 1.6;
    max-width: 780px;
    margin: 0 auto;
  }

  .safety-desc strong {
    color: #0f172a;
  }

  .escalation-subheading {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 1.5rem;
  }

  .escalation-cases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .escalation-case-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    position: relative;
    transition: all 0.2s ease;
  }

  .escalation-case-card:hover {
    border-color: #cbd5e1;
    background: #ffffff;
  }

  .case-number {
    font-size: 1.35rem;
    font-weight: 900;
    color: rgba(11, 37, 145, 0.25);
    margin-bottom: 0.4rem;
  }

  .escalation-case-card h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
    margin-bottom: 0.5rem;
  }

  .escalation-case-card p {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.5;
  }

  /* ============================================================== */
  /* 6. PRIVACIDAD Y CUMPLIMIENTO                                   */
  /* ============================================================== */
  .privacy-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .privacy-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: all 0.25s ease;
  }

  .privacy-card:hover {
    border-color: #cbd5e1;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -5px rgba(0, 0, 0, 0.06);
  }

  .privacy-card.span-full {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: center;
    gap: 1.5rem;
    background: linear-gradient(135deg, rgba(11, 37, 145, 0.03) 0%, rgba(21, 198, 59, 0.03) 100%);
    border: 1.5px solid rgba(11, 37, 145, 0.15);
  }

  .privacy-icon-box {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .privacy-card h4 {
    font-size: 1.12rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
  }

  .privacy-card p {
    font-size: 0.92rem;
    color: #64748b;
    line-height: 1.6;
  }

  /* ============================================================== */
  /* 7. CÓMO SE IMPLEMENTA                                          */
  /* ============================================================== */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-bottom: 2rem;
  }

  .step-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2.25rem 1.75rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.3s ease;
  }

  .step-card:hover {
    transform: translateY(-4px);
    border-color: #cbd5e1;
    box-shadow: 0 12px 26px -5px rgba(0, 0, 0, 0.08);
  }

  .step-badge-number {
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #0b2591;
    background: rgba(11, 37, 145, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    align-self: flex-start;
  }

  .step-icon-wrap {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-icon-wrap.blue {
    background: rgba(11, 37, 145, 0.08);
    color: #0b2591;
  }

  .step-icon-wrap.green {
    background: rgba(21, 198, 59, 0.12);
    color: #15C63B;
  }

  .step-card h3 {
    font-size: 1.18rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
  }

  .step-card p {
    font-size: 0.92rem;
    color: #64748b;
    line-height: 1.6;
  }

  .integration-notice-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.25rem 1.75rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .notice-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .notice-content {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.55;
  }

  .notice-content strong {
    color: #0b2591;
  }

  /* ============================================================== */
  /* 8. INTEGRACIONES                                               */
  /* ============================================================== */
  .integrations-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .integration-tile {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .integration-tile:hover {
    border-color: #cbd5e1;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.06);
  }

  .tile-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tile-info h4 {
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .tile-info p {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.5;
  }

  /* ============================================================== */
  /* 9. CASOS DE USO                                                */
  /* ============================================================== */
  .use-cases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .use-case-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .use-case-card.span-2-col {
    grid-column: 1 / -1;
  }

  .use-case-card:hover {
    transform: translateY(-3px);
    border-color: #cbd5e1;
    box-shadow: 0 12px 26px -5px rgba(0, 0, 0, 0.07);
  }

  .case-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .case-tag {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
  }

  .case-tag.blue {
    background: rgba(11, 37, 145, 0.08);
    color: #0b2591;
  }

  .case-tag.green {
    background: rgba(21, 198, 59, 0.12);
    color: #15C63B;
  }

  .case-icon {
    font-size: 1.25rem;
  }

  .case-card-title {
    font-size: 1.22rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
  }

  .case-scenario {
    font-size: 0.92rem;
    color: #475569;
    line-height: 1.55;
    background: #f8fafc;
    border-left: 3px solid #0b2591;
    padding: 0.75rem 1rem;
    border-radius: 0 6px 6px 0;
  }

  .case-scenario strong {
    color: #0f172a;
  }

  .case-solution-flow {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .flow-pill {
    font-size: 0.86rem;
    color: #334155;
    background: #f1f5f9;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    line-height: 1.45;
  }

  /* ============================================================== */
  /* 10. FAQ ACCORDION                                              */
  /* ============================================================== */
  .faq-accordion-wrapper {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .faq-item.is-open {
    border-color: #cbd5e1;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
  }

  .faq-question-btn {
    width: 100%;
    padding: 1.25rem 1.5rem;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
  }

  .faq-question-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
  }

  .faq-toggle-icon {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0b2591;
    flex-shrink: 0;
  }

  .faq-answer-panel {
    display: none;
    padding: 0 1.5rem 1.35rem;
    font-size: 0.94rem;
    color: #475569;
    line-height: 1.65;
  }

  .faq-item.is-open .faq-answer-panel {
    display: block;
    animation: fadeInFaq 0.25s ease forwards;
  }

  @keyframes fadeInFaq {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ============================================================== */
  /* 11. CTA FINAL                                                  */
  /* ============================================================== */
  .cta-section {
    padding: 5rem 0 3rem;
  }

  .cta-card {
    background: linear-gradient(135deg, #0b2591 0%, #061868 100%);
    border-radius: 24px;
    padding: 4.5rem 2rem;
    text-align: center;
    color: #ffffff;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 45px -10px rgba(11, 37, 145, 0.4);
  }

  .cta-glow-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(21, 198, 59, 0.25) 0%, rgba(11, 37, 145, 0) 70%);
    pointer-events: none;
  }

  .cta-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .cta-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    position: relative;
    z-index: 1;
  }

  .cta-description {
    font-size: 1.15rem;
    color: #cbd5e1;
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto 2.5rem;
    position: relative;
    z-index: 1;
  }

  .cta-actions-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
    position: relative;
    z-index: 1;
  }

  .btn-cta-primary {
    background-color: #15C63B;
    color: #0f172a;
    padding: 1rem 2.2rem;
    border-radius: 8px;
    font-weight: 800;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 4px 18px rgba(21, 198, 59, 0.4);
    transition: all 0.25s ease;
  }

  .btn-cta-primary:hover {
    background-color: #12ad33;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(21, 198, 59, 0.5);
  }

  .btn-cta-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.25s ease;
  }

  .btn-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .cta-guarantees-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: #94a3b8;
    position: relative;
    z-index: 1;
  }

  .guarantee-item {
    color: #e2e8f0;
  }

  .guarantee-sep {
    color: rgba(255, 255, 255, 0.3);
  }

  /* ============================================================== */
  /* RESPONSIVE BREAKPOINTS (Mobile-First approach)                 */
  /* ============================================================== */
  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-title {
      font-size: 2.35rem;
    }

    .problem-grid,
    .comparison-grid,
    .benefits-grid,
    .steps-grid,
    .privacy-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .integrations-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .escalation-cases-grid {
      grid-template-columns: 1fr;
    }

    .panel-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .section-container {
      padding: 3.5rem 0;
    }

    .section-title {
      font-size: 1.85rem;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-description {
      font-size: 1rem;
    }

    .problem-grid,
    .comparison-grid,
    .benefits-grid,
    .steps-grid,
    .integrations-grid,
    .use-cases-grid,
    .privacy-grid {
      grid-template-columns: 1fr;
    }

    .privacy-card.span-full {
      flex-direction: column;
      align-items: flex-start;
    }

    .process-tabs-nav {
      justify-content: flex-start;
    }

    .process-tabs-content {
      padding: 1.5rem;
