---
import Layout from '../../layouts/Layout.astro';
import DemoModal from '../../components/DemoModal.astro';
---

<Layout
  title="Agente de IA para Hoteles y Alojamientos Turísticos | MM SmartInbox"
  description="IA que atiende a tus huéspedes en todo momento del viaje. Responde consultas de disponibilidad y tarifas, asiste durante la estadía y fideliza tras el check-out conectada a tu PMS."
>
  <div class="hotel-page">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 1. HERO / BANNER -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="hero-section" id="hero">
      <div class="hero-container">
        
        <!-- Columna Izquierda: Texto y CTA -->
        <div class="hero-text-col" data-aos="fade-right">
          <div class="hero-badge">
            <span class="badge-pulse"></span>
            <span>Agente de IA para Hoteles Boutique, Cadenas, Hostels y Alojamientos</span>
          </div>

          <h1 class="hero-title">
            IA que atiende a tus huéspedes en todo momento del viaje
          </h1>

          <p class="hero-description">
            Responde consultas de disponibilidad, tarifas y servicios, asiste durante la estadía y mantiene la conversación después del check-out, para que tu equipo se enfoque en brindar una experiencia memorable en lugar de repetir la misma información.
          </p>

          <div class="hero-actions">
            <button type="button" class="btn btn-navy" data-open-quote>
              Reservar una demo
            </button>
            <a href="#automatizaciones" class="btn btn-outline">
              Ver etapas del viaje
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>

          <!-- Microcopy de confianza -->
          <div class="hero-microcopy">
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Disponible 24/7</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Multi-idioma</span>
            </div>
            <span class="micro-sep">•</span>
            <div class="microcopy-item">
              <span class="micro-icon">✓</span>
              <span>Integración con tu PMS y canales</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Visual Journey del Huésped (Consulta → Reserva → Pre-estadía → Estadía → Post-estadía) -->
        <div class="hero-visual-col" data-aos="fade-left" data-aos-delay="150">
          <div class="flow-visual-wrapper">
            <div class="flow-glass-card">
              
              <div class="flow-card-header">
                <div class="live-indicator">
                  <span class="pulse-dot"></span>
                  <span class="live-label">Agente Hotelero IA Activo</span>
                </div>
                <span class="channel-pill">WhatsApp • Web • PMS Sincronizado</span>
              </div>

              <!-- Pipeline Journey del Huésped en 5 etapas -->
              <div class="flow-stream">
                
                <!-- Etapa 1: Consulta -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">1. Consulta</span>
                      <span class="flow-step-meta">WhatsApp • 22:45 hs</span>
                    </div>
                    <div class="chat-bubble user-bubble">
                      "Hola! ¿Tienen habitación disponible para 2 personas del 14 al 17 de febrero? ¿Aceptan mascotas?"
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 2: Reserva y Disponibilidad en vivo -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">2. Reserva directa</span>
                      <span class="flow-badge-ai">Disponible en PMS ✓</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>¡Hola Florencia! Sí, tenemos disponibilidad en <strong>Suite Balcón</strong> ($120/noche) con desayuno incluido y <strong>somos pet-friendly 🐾</strong>. Te dejo el link directo con 10% off de bienvenida.</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 3: Pre-estadía -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle blue-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">3. Pre-estadía</span>
                      <span class="flow-step-meta">48 hs antes del check-in</span>
                    </div>
                    <div class="property-match-mini">
                      <div class="prop-thumb">🛎️</div>
                      <div class="prop-details">
                        <span class="prop-title">Check-in digital + Ubicación</span>
                        <span class="prop-sub">Transfer coordinado • Preferencias guardadas</span>
                      </div>
                      <span class="prop-badge">Completado</span>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 4: Estadía -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle green-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">4. Durante la estadía</span>
                      <span class="flow-badge-confirmed">Concierge 24/7</span>
                    </div>
                    <div class="chat-bubble ai-bubble">
                      <span class="ai-avatar">IA</span>
                      <p>El desayuno se sirve en la terraza de <strong>07:30 a 10:30 hs</strong>. La clave de Wi-Fi es <em>BoutiqueGuest</em>. ¿Necesitás toallas extra para la piscina o sugerencias de restaurantes?</p>
                    </div>
                  </div>
                </div>

                <!-- Conector -->
                <div class="flow-line-connector">
                  <div class="connector-track"></div>
                  <div class="connector-dot"></div>
                </div>

                <!-- Etapa 5: Post-estadía -->
                <div class="flow-step-item">
                  <div class="flow-icon-circle purple-theme">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  </div>
                  <div class="flow-step-body">
                    <div class="flow-step-header">
                      <span class="flow-step-tag">5. Post-estadía</span>
                      <span class="flow-step-meta">Fidelización y Reseñas</span>
                    </div>
                    <div class="crm-sync-box">
                      <span class="crm-tag">Encuesta 5★ Enviada</span>
                      <span class="crm-tag">Google Reviews</span>
                      <span class="crm-tag">Cupón 15% próximo viaje</span>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Barra de integraciones en el pie del Hero visual -->
              <div class="flow-systems-bar">
                <span class="systems-label">Sincronizado con:</span>
                <span class="system-tag">PMS Hotelero</span>
                <span class="system-tag">WhatsApp API</span>
                <span class="system-tag">Channel Manager</span>
                <span class="system-tag">Motor de Reservas</span>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 2. EL PROBLEMA (Cuando la ocupación crece, la recepción se satura) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="problema" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">El Desafío de la Operación Hotelera</div>
        <h2 class="section-title">Cuando la ocupación crece, la recepción se satura</h2>
        <p class="section-subtitle">
          Entre atender al huésped en el mostrador, coordinar el check-in y contestar canales digitales a toda hora, el equipo se desborda y las oportunidades de reserva directa se escapan.
        </p>
      </div>

      <div class="problem-grid">
        
        <!-- Situación 1 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="100">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Consultas simultáneas por múltiples canales</h3>
            <p>Disponibilidad y tarifas consultadas al mismo tiempo por WhatsApp, Instagram, el chat de la web y correo electrónico, saturando al personal de recepción.</p>
          </div>
        </div>

        <!-- Situación 2 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="150">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Preguntas idénticas repetidas decenas de veces</h3>
            <p>Horarios de check-in y check-out, desayuno incluido, política de mascotas, estacionamiento, traslados y condiciones de cancelación consumen horas del día.</p>
          </div>
        </div>

        <!-- Situación 3 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="200">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Reservas perdidas por demoras en la respuesta</h3>
            <p>El viajero compara alojamientos de noche o en su tiempo libre. Si el hotel tarda horas o responde al día siguiente, el huésped ya reservó en otro lugar.</p>
          </div>
        </div>

        <!-- Situación 4 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="250">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Barrera idiomática con huéspedes internacionales</h3>
            <p>Consultas en inglés, portugués, francés o alemán que la recepción no siempre puede responder con rapidez, fluidez y calidez en el momento exacto.</p>
          </div>
        </div>

        <!-- Situación 5 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="300">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Recepción interrumpida frente al huésped</h3>
            <p>El personal atiende llamadas y responde chats mientras tiene a una persona esperando en el mostrador para hacer su check-in, perjudicando la experiencia presencial.</p>
          </div>
        </div>

        <!-- Situación 6 -->
        <div class="problem-card" data-aos="fade-up" data-aos-delay="350">
          <div class="problem-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div class="problem-content">
            <h3>Postestadía sin seguimiento ni fidelización</h3>
            <p>Una vez realizado el check-out, no se recopilan reseñas en Google o TripAdvisor ni se envían propuestas para incentivar una próxima estadía directa.</p>
          </div>
        </div>

      </div>

      <!-- Cierre destacado de la sección -->
      <div class="problem-closing-banner" data-aos="fade-up">
        <div class="closing-banner-inner">
          <div class="closing-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18"></path>
              <path d="M5 21V7l7-4 7 4v14"></path>
              <rect x="9" y="12" width="6" height="9"></rect>
              <path d="M9 7h.01"></path>
              <path d="M15 7h.01"></path>
            </svg>
          </div>
          <p class="closing-text">
            <strong>La IA no reemplaza la calidez de tu equipo:</strong> le quita tareas repetitivas para que se enfoque en la experiencia del huésped.
          </p>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 3. QUÉ HACE UN AGENTE DE IA (Más que responder: entiende, informa y gestiona) -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container bg-subtle" id="que-hace" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Evolución Tecnológica en Hospitalidad</div>
        <h2 class="section-title">Más que responder: entiende, informa y gestiona</h2>
        <p class="section-subtitle">
          Un chatbot convencional se limita a botones y respuestas fijas. Un Agente de IA para Hoteles razona con contexto real, consulta tu sistema hotelero y gestiona acciones operativas.
        </p>
      </div>

      <div class="comparison-grid">
        
        <!-- Card 1: Chatbot básico -->
        <div class="comp-card bot-card" data-aos="fade-up" data-aos-delay="100">
          <div class="comp-header">
            <span class="comp-type-badge basic">Enfoque Limitado</span>
            <h3 class="comp-title">Chatbot tradicional</h3>
            <p class="comp-tagline">Responde preguntas simples</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>Menús rígidos con opciones numéricas ("Marcá 1 para tarifas, 2 para ubicación").</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>Textos prearmados sin verificar si las habitaciones están realmente libres.</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>Se confunde ante consultas combinadas ("Somos 2 adultos y un bebé, ¿tienen cuna y vista al mar?").</span>
            </li>
            <li class="comp-item neutral">
              <span class="dot-icon">✕</span>
              <span>No se conecta al PMS para verificar disponibilidad ni registrar solicitudes.</span>
            </li>
          </ul>
        </div>

        <!-- Card 2: Agente IA - Entiende Contexto -->
        <div class="comp-card agent-card featured" data-aos="fade-up" data-aos-delay="200">
          <div class="comp-badge-recommended">Inteligencia y Contexto</div>
          <div class="comp-header">
            <span class="comp-type-badge premium">Agente de IA</span>
            <h3 class="comp-title">Entiende contexto</h3>
            <p class="comp-tagline">Tipo de viaje, fechas y necesidades</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Comprende lenguaje natural, audios y textos en múltiples idiomas de forma nativa.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Interpreta el tipo de viaje (pareja, familia, escapada relax, corporativo o luna de miel).</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Recuerda preferencias del huésped: cama king, cuna, piso alto, alergias o mascotas.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Mantiene un tono empático, cálido y profesional acorde a la categoría de tu hotel.</span>
            </li>
          </ul>
        </div>

        <!-- Card 3: Agente IA - Ejecuta Acciones -->
        <div class="comp-card agent-card action" data-aos="fade-up" data-aos-delay="300">
          <div class="comp-badge-recommended action-badge">Capacidad Operativa</div>
          <div class="comp-header">
            <span class="comp-type-badge accent">Agente de IA</span>
            <h3 class="comp-title">Ejecuta acciones</h3>
            <p class="comp-tagline">Consulta disponibilidad, coordina y deriva</p>
          </div>
          <ul class="comp-features">
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Consulta disponibilidad de habitaciones y tarifas actualizadas en tu PMS o motor de reservas.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Explica políticas del hotel, servicios incluidos, horarios y métodos de pago aceptados.</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Coordina peticiones durante la estadía (toallas extra, transfer, room service, late check-out).</span>
            </li>
            <li class="comp-item positive">
              <span class="check-icon">✓</span>
              <span>Registra datos, entrega enlaces de reserva directa y deriva a recepción cuando es necesario.</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Texto simple complementario -->
      <div class="what-it-does-summary" data-aos="fade-up">
        <p>
          El agente puede <strong>consultar el PMS y channel manager</strong>, comunicar <strong>políticas del hotel y servicios</strong>, y verificar la <strong>disponibilidad de habitaciones</strong> para brindar respuestas reales y actualizadas en todo momento.
        </p>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 4. BENEFICIOS PARA TU HOTEL Y TU EQUIPO -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="section-container" id="beneficios" data-aos="fade-up">
      <div class="section-header text-center">
        <div class="section-badge">Valor para tu Negocio</div>
        <h2 class="section-title">Beneficios para tu hotel y tu equipo</h2>
        <p class="section-subtitle">
          Diseñado para que hoteles boutique, hostels, aparts y cadenas hoteleras optimicen su operación sin perder la hospitalidad que los distingue.
        </p>
      </div>

      <div class="benefits-grid">
        
        <!-- Beneficio 1 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="100">
          <div class="benefit-icon-wrapper blue-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3>Respuestas 24/7 en múltiples idiomas</h3>
          <p>
            Atención instantánea a viajeros de todo el mundo en su idioma natal, sin importar la diferencia horaria ni el día de la semana.
          </p>
        </div>

        <!-- Beneficio 2 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="150">
          <div class="benefit-icon-wrapper green-bg">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3>Menos consultas repetitivas en recepción</h3>
          <p>
            Descomprime el teléfono y mostrador resolviendo dudas frecuentes sobre horarios, servicios, comodidades, desayuno y check-in.
          </p>
        </div>

        <!-- Beneficio 3 -->
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="200">
          <div class="benefit-icon-wrapper blue-bg">
