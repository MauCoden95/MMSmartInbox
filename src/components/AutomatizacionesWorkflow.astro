<script is:inline>
  function setupAutomationSection() {
    const rootEl = document.getElementById('automation-workflow-root');
    const tabComercial = document.getElementById('tab-comercial-btn');
    const tabRag = document.getElementById('tab-rag-btn');
    const panelComercial = document.getElementById('panel-comercial');
    const panelRag = document.getElementById('panel-rag');
    const hubIndicator = document.getElementById('hub-mode-indicator');

    if (!rootEl || !tabComercial || !tabRag) return;

    function activateMode(mode) {
      if (mode === 'rag') {
        // Update tabs
        tabRag.classList.add('active');
        tabRag.setAttribute('aria-selected', 'true');
        tabComercial.classList.remove('active');
        tabComercial.setAttribute('aria-selected', 'false');

        // Update canvas root mode
        rootEl.setAttribute('data-active-mode', 'rag');

        // Update panels
        if (panelRag && panelComercial) {
          panelRag.classList.add('active');
          panelComercial.classList.remove('active');
        }

        // Update central hub indicator
        if (hubIndicator) {
          hubIndicator.textContent = 'Modo RAG & ERP Activo';
          hubIndicator.parentElement.style.color = '#0284c7';
        }
      } else {
        // Default: comercial
        tabComercial.classList.add('active');
        tabComercial.setAttribute('aria-selected', 'true');
        tabRag.classList.remove('active');
        tabRag.setAttribute('aria-selected', 'false');

        rootEl.setAttribute('data-active-mode', 'comercial');

        if (panelRag && panelComercial) {
          panelComercial.classList.add('active');
          panelRag.classList.remove('active');
        }

        if (hubIndicator) {
          hubIndicator.textContent = 'Modo Comercial Activo';
          hubIndicator.parentElement.style.color = '#15803d';
        }
      }
    }

    tabComercial.onclick = () => activateMode('comercial');
    tabRag.onclick = () => activateMode('rag');
  }

  // Bind to standard page load & Astro ClientRouter transitions
  document.addEventListener('DOMContentLoaded', setupAutomationSection);
  document.addEventListener('astro:page-load', setupAutomationSection);
</script>
