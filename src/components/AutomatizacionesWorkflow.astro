---
// src/components/AutomatizacionesWorkflow.astro
---
<div id="automatizaciones" class="section-card card-automatizaciones" data-aos="fade-up">
  <div class="section-header">
    <h2>Automatizaciones</h2>
    <p class="subtitle">Orquestación inteligente entre todos tus sistemas</p>
  </div>

  <div class="automation-canvas">
    <!-- Top Row Apps -->
    <div class="apps-row">
      <div class="app-chip">
        <div class="chip-icon bg-wa">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"/></svg>
        </div>
        <span>WhatsApp API</span>
      </div>

      <div class="app-chip">
        <div class="chip-icon bg-crm">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
        </div>
        <span>HubSpot / CRM</span>
      </div>
    </div>

    <!-- Center Hub -->
    <div class="hub-center">
      <div class="hub-pulse"></div>
      <img src="/images/Robot.png" alt="Orquestador IA" class="hub-robot" />
      <span class="hub-label">Agente Central de IA</span>
    </div>

    <!-- Bottom Row Apps -->
    <div class="apps-row">
      <div class="app-chip">
        <div class="chip-icon bg-sheets">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="3" x2="9" y2="21"></line></svg>
        </div>
        <span>Google Sheets</span>
      </div>

      <div class="app-chip">
        <div class="chip-icon bg-email">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </div>
        <span>Mailchimp / Email</span>
      </div>
    </div>
  </div>
</div>

<style>
  .section-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.8rem;
  }

  .section-header h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    margin-bottom: 0.25rem;
  }

  .section-header .subtitle {
    font-size: 0.9rem;
    color: #64748b;
  }

  .automation-canvas {
    background: #f8fafc;
    border-radius: 16px;
    padding: 2rem 1.5rem;
    border: 1px solid #f1f5f9;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    position: relative;
  }

  .apps-row {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
  }

  .app-chip {
    background: #ffffff;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #1e293b;
  }

  .chip-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .bg-wa { background: #25d366; }
  .bg-crm { background: #3b82f6; }
  .bg-sheets { background: #10b981; }
  .bg-email { background: #f59e0b; }

  .hub-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .hub-pulse {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(11, 37, 145, 0.1);
    animation: hubPulse 3s ease-in-out infinite alternate;
  }

  @keyframes hubPulse {
    0% { transform: translate(-50%, -60%) scale(0.9); opacity: 0.5; }
    100% { transform: translate(-50%, -60%) scale(1.2); opacity: 1; }
  }

  .hub-robot {
    width: 80px;
    height: auto;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.12));
  }

  .hub-label {
    font-size: 0.82rem;
    font-weight: 800;
    color: #0b2591;
    margin-top: 0.4rem;
  }

  @media (max-width: 640px) {
    .apps-row {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
