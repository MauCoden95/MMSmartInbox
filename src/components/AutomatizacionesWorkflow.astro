---
// src/components/AutomatizacionesWorkflow.astro
---
<div id="automatizaciones" class="section-card card-automatizaciones" data-aos="fade-up">
  <!-- Section Header -->
  <div class="section-header">
    <div class="header-badge">
      <span class="badge-dot"></span>
      <span>Enterprise & RAG Ready</span>
    </div>
    <h2>Automatizaciones Empresariales</h2>
    <p class="subtitle">Orquestación inteligente entre flujos comerciales, bases de conocimiento corporativas y ERPs</p>
  </div>

  <!-- Category Selector Tabs (Vertical Stack) -->
  <div class="tabs-container" role="tablist" aria-label="Categorías de Automatización">
    <button 
      type="button"
      class="tab-btn active" 
      id="tab-comercial-btn"
      role="tab" 
      aria-selected="true" 
      aria-controls="panel-comercial"
      data-tab="comercial"
    >
      <span class="tab-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </span>
      <span class="tab-text">
        <strong>Automatización Comercial</strong>
        <span class="tab-tag">Front-Office / Ventas</span>
      </span>
      <span class="tab-check-icon">✓</span>
    </button>

    <button 
      type="button" 
      class="tab-btn" 
      id="tab-rag-btn"
      role="tab" 
      aria-selected="false" 
      aria-controls="panel-rag"
      data-tab="rag"
    >
      <span class="tab-icon icon-rag-sparkle">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path>
        </svg>
      </span>
      <span class="tab-text">
        <strong>Automatización Empresarial & RAG</strong>
        <span class="tab-tag tag-rag">Back-Office / RAG Corporativo</span>
      </span>
      <span class="tab-check-icon">✓</span>
    </button>
  </div>

  <!-- Dynamic Automation Canvas (Full Vertical Architecture) -->
  <div class="automation-canvas-wrapper" id="automation-workflow-root" data-active-mode="comercial">
    <div class="automation-canvas">
      
      <!-- Top Group: Conocimiento & Sistemas Internos (Back-Office) -->
      <div class="group-section-header">
        <span class="group-label">Bases Corporativas & ERPs</span>
      </div>

      <div class="nodes-vertical-stack">
        <!-- Node 1: RAG Vector DB with Accordion Tooltip -->
        <div class="enterprise-node node-rag" id="node-vector-rag">
          <div class="node-main-row">
            <div class="node-icon bg-rag">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <div class="node-content">
              <div class="node-title-row">
                <span class="node-title">Base de Datos Vectorial / Docs (RAG)</span>
                <span class="badge-rag-glow">RAG</span>
              </div>
              <span class="node-desc">PDFs, reglamentos, manuales y contratos</span>
            </div>
          </div>

          <!-- RAG Info Callout -->
          <div class="rag-info-box" id="tooltip-rag">
            <div class="tooltip-badge">RAG Architecture</div>
            <p><strong>RAG (Retrieval-Augmented Generation):</strong> Conectamos la IA a los PDFs, reglamentos, catálogos y bases de datos de tu empresa para respuestas 100% precisas sin alucinaciones.</p>
          </div>
        </div>

        <!-- Node 2: ERP / Sistemas Internos -->
        <div class="enterprise-node node-erp" id="node-erp-sistemas">
          <div class="node-main-row">
            <div class="node-icon bg-erp">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <div class="node-content">
              <div class="node-title-row">
                <span class="node-title">ERP / Sistemas Internos</span>
                <span class="node-badge-sub">Back-End</span>
              </div>
              <span class="node-desc">SAP, Oracle, Salesforce, Bases SQL & APIs</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Central Connector Arrow (Vertical) -->
      <div class="vertical-flow-indicator">
        <div class="connector-line"></div>
        <div class="connector-arrow-down">▼</div>
      </div>

      <!-- Center Hub: Agente Central de IA -->
      <div class="hub-center-card">
        <div class="hub-halo halo-outer"></div>
        <div class="hub-halo halo-inner"></div>
        <div class="robot-circle">
          <img src="/images/Robot.png" alt="Orquestador IA Central" class="hub-robot" />
        </div>
        <div class="hub-meta">
          <span class="hub-title">Agente Central de IA</span>
          <span class="hub-status-chip">
            <span class="status-pulse-dot"></span>
            <span id="hub-mode-indicator">Modo Comercial Activo</span>
          </span>
        </div>
      </div>

      <!-- Central Connector Arrow (Vertical) -->
      <div class="vertical-flow-indicator">
        <div class="connector-line"></div>
        <div class="connector-arrow-down">▼</div>
      </div>

      <!-- Bottom Group: Canales de Contacto & Herramientas de Ventas -->
      <div class="group-section-header">
        <span class="group-label">Canales de Entrada & Automatizaciones</span>
      </div>

      <div class="nodes-vertical-stack">
        <!-- Node 3: WhatsApp API / CRM -->
        <div class="enterprise-node node-comercial" id="node-wa-crm">
          <div class="node-main-row">
            <div class="node-icon bg-wa">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"/>
              </svg>
            </div>
            <div class="node-content">
              <span class="node-title">WhatsApp API / CRM</span>
              <span class="node-desc">Meta Cloud API, HubSpot, Zoho CRM</span>
            </div>
          </div>
        </div>

        <!-- Node 4: Google Sheets / Excel Corporativo -->
        <div class="enterprise-node node-comercial" id="node-sheets-excel">
          <div class="node-main-row">
            <div class="node-icon bg-sheets">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="3" x2="9" y2="21"></line>
              </svg>
            </div>
            <div class="node-content">
              <span class="node-title">Google Sheets / Excel Corporativo</span>
              <span class="node-desc">Sincronización de registros y reportes en vivo</span>
            </div>
          </div>
        </div>

        <!-- Node 5: +100 APIs / Sistemas Propietarios -->
        <div class="enterprise-node node-apis" id="node-apis-prop">
          <div class="node-main-row">
            <div class="node-icon bg-apis">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </div>
            <div class="node-content">
              <span class="node-title">+100 APIs / Sistemas Propietarios</span>
              <span class="node-desc">Webhooks, Make, Zapier & Pasarelas de Pago</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Step-by-Step Flow Pipeline Display (100% Vertical) -->
    <div class="flow-pipeline-card">
      <!-- Panel 1: Comercial Flow -->
      <div class="flow-panel active" id="panel-comercial">
        <div class="pipeline-header">
          <span class="pipeline-tag tag-front">Flujo de Front-Office / Ventas</span>
          <h4 class="pipeline-title">Secuencia de Conversión Comercial</h4>
        </div>

        <div class="pipeline-steps-vertical">
          <div class="step-card-vertical">
            <div class="step-num">1</div>
            <div class="step-info">
              <span class="step-badge">Canal de Entrada</span>
              <strong>WhatsApp API</strong>
            </div>
          </div>

          <div class="step-arrow-vertical">↓</div>

          <div class="step-card-vertical highlight-chip">
            <div class="step-num">2</div>
            <div class="step-info">
              <span class="step-badge">Procesamiento Inteligente</span>
              <strong>Agente IA comercial</strong>
            </div>
          </div>

          <div class="step-arrow-vertical">↓</div>

          <div class="step-card-vertical">
            <div class="step-num">3</div>
            <div class="step-info">
              <span class="step-badge">Sincronización</span>
              <strong>Actualiza CRM / HubSpot</strong>
            </div>
          </div>

          <div class="step-arrow-vertical">↓</div>

          <div class="step-card-vertical">
            <div class="step-num">4</div>
            <div class="step-info">
              <span class="step-badge">Acción Final</span>
              <strong>Agenda llamada en Calendar</strong>
            </div>
          </div>
        </div>

        <div class="benefit-callout benefit-comercial">
          <span class="benefit-icon">⚡</span>
          <div class="benefit-text">
            <strong>Impacto Comercial:</strong>
            <span>Respuestas instantáneas 24/7 y cero pérdida de prospectos calificados.</span>
          </div>
        </div>
      </div>

      <!-- Panel 2: RAG Empresarial Flow -->
      <div class="flow-panel" id="panel-rag">
        <div class="pipeline-header">
          <span class="pipeline-tag tag-back">Flujo de Back-Office / RAG Corporativo</span>
          <h4 class="pipeline-title">Arquitectura Retrieval-Augmented Generation & ERP</h4>
        </div>

        <div class="pipeline-steps-vertical">
          <div class="step-card-vertical">
            <div class="step-num">1</div>
            <div class="step-info">
              <span class="step-badge">Requerimiento</span>
              <strong>Pregunta del Empleado / Cliente</strong>
            </div>
          </div>

          <div class="step-arrow-vertical">↓</div>

          <div class="step-card-vertical highlight-rag-chip">
            <div class="step-num">2</div>
            <div class="step-info">
              <span class="step-badge">Búsqueda Vectorial</span>
              <strong>Búsqueda en Base de Conocimiento RAG / PDFs / ERP</strong>
            </div>
          </div>

          <div class="step-arrow-vertical">↓</div>

          <div class="step-card-vertical">
            <div class="step-num">3</div>
            <div class="step-info">
              <span class="step-badge">Comprensión & Razonamiento</span>
              <strong>Agente IA sintetiza e interpreta</strong>
            </div>
          </div>

          <div class="step-arrow-vertical">↓</div>

          <div class="step-card-vertical">
            <div class="step-num">4</div>
            <div class="step-info">
              <span class="step-badge">Resolución</span>
              <strong>Respuesta con contexto preciso + Ejecución en ERP</strong>
            </div>
          </div>
        </div>

        <div class="benefit-callout benefit-rag">
          <span class="benefit-icon">🚀</span>
          <div class="benefit-text">
            <strong>Impacto Operativo & RAG:</strong>
            <span>Reducción drástica de cuellos de botella en RRHH, Legales y Operaciones; respuestas instantáneas basadas en documentación interna de tu empresa.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Enterprise Pillars Bar (100% Vertical) -->
  <div class="enterprise-pillars-bar">
    <div class="pillar-item">
      <div class="pillar-icon-box">🧠</div>
      <div class="pillar-details">
        <span class="pillar-title">RAG & Bases de Conocimiento Propias</span>
        <span class="pillar-desc">Indexación vectorial de PDFs, políticas internas y catálogos sin alucinaciones.</span>
      </div>
    </div>

    <div class="pillar-divider-horizontal"></div>

    <div class="pillar-item">
      <div class="pillar-icon-box">⚙️</div>
      <div class="pillar-details">
        <span class="pillar-title">Automatización de Reportes & Operaciones</span>
        <span class="pillar-desc">Generación autónoma de reportes, aprobaciones internas y flujos de back-office.</span>
      </div>
    </div>

    <div class="pillar-divider-horizontal"></div>

    <div class="pillar-item">
      <div class="pillar-icon-box">🔒</div>
      <div class="pillar-details">
        <span class="pillar-title">Conexión Segura con Sistemas Internos / ERPs</span>
        <span class="pillar-desc">Integración cifrada con SAP, SQL, Salesforce y sistemas legados propietarios.</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     Card & Section Layout (Strictly Zero Horizontal Scroll)
     ========================================================================== */
  .section-card {
    background: #ffffff;
    border-radius: 24px;
    padding: 2rem 1.5rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    position: relative;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .section-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #3A3DEE 0%, #06b6d4 50%, #15C63B 100%);
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    background: rgba(58, 61, 238, 0.08);
    border: 1px solid rgba(58, 61, 238, 0.2);
    font-size: 0.7rem;
    font-weight: 700;
    color: #3A3DEE;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #15C63B;
    box-shadow: 0 0 8px #15C63B;
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .section-header h2 {
    font-size: 1.7rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    margin-bottom: 0.35rem;
  }

  .section-header .subtitle {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.45;
  }

  /* ==========================================================================
     Category Selector Tabs (Stacked Vertically)
     ========================================================================== */
  .tabs-container {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: #f1f5f9;
    padding: 0.45rem;
    border-radius: 16px;
    margin-bottom: 1.5rem;
    border: 1px solid #e2e8f0;
    width: 100%;
    box-sizing: border-box;
  }

  .tab-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    color: #64748b;
    font-family: inherit;
    text-align: left;
    box-sizing: border-box;
    position: relative;
  }

  .tab-btn:hover {
    color: #0f172a;
    background: rgba(255, 255, 255, 0.7);
  }

  .tab-btn.active {
    background: #ffffff;
    color: #0f172a;
    border-color: #cbd5e1;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
  }

  .tab-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: #e2e8f0;
    color: #475569;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .tab-btn.active .tab-icon {
    background: #3A3DEE;
    color: #ffffff;
  }

  .tab-btn[data-tab="rag"].active .tab-icon {
    background: linear-gradient(135deg, #06b6d4, #6366f1);
    color: #ffffff;
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.4);
  }

  .tab-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }

  .tab-text strong {
    font-size: 0.88rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
  }

  .tab-tag {
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
  }

  .tag-rag {
    color: #0284c7;
    font-weight: 700;
  }

  .tab-check-icon {
    font-size: 0.9rem;
    font-weight: 800;
    color: #3A3DEE;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .tab-btn.active .tab-check-icon {
    opacity: 1;
  }

  .tab-btn[data-tab="rag"].active .tab-check-icon {
    color: #0284c7;
  }

  /* ==========================================================================
     Automation Canvas (100% Vertical Flow)
     ========================================================================== */
  .automation-canvas-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 1.25rem 1rem;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .automation-canvas {
    background: #ffffff;
    border: 1px solid #edf2f7;
    border-radius: 16px;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    box-sizing: border-box;
  }

  .group-section-header {
    text-align: center;
    padding: 0.2rem 0;
  }

  .group-label {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #94a3b8;
    background: #f1f5f9;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  /* Vertical Nodes Stack */
  .nodes-vertical-stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
    box-sizing: border-box;
  }

  .enterprise-node {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-sizing: border-box;
    width: 100%;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .enterprise-node:hover {
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
  }

  .node-main-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    box-sizing: border-box;
  }

  .node-icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
  }

  .bg-rag { background: linear-gradient(135deg, #0284c7, #6366f1); }
  .bg-erp { background: linear-gradient(135deg, #475569, #1e293b); }
  .bg-wa { background: #25d366; }
  .bg-sheets { background: #10b981; }
  .bg-apis { background: #6366f1; }

  .node-content {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .node-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
  }

  .node-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
  }

  .node-desc {
    font-size: 0.72rem;
    color: #64748b;
    line-height: 1.3;
  }

  .badge-rag-glow {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: rgba(14, 165, 233, 0.15);
    color: #0284c7;
    border: 1px solid rgba(14, 165, 233, 0.3);
  }

  .node-badge-sub {
