---
// src/components/Banner.astro
---
<section id="inicio" class="hero-section">
  <div class="hero-container">
    <div class="hero-content" data-aos="fade-right">
      <h1 class="hero-title">
        Tu Empresa Puede Tener Un Agente de IA Trabajando Por Ella.
      </h1>
      <p class="hero-description">
        Implementamos IA aplicada y automatización inteligente para optimizar tus procesos, aumentar la productividad y mejorar la experiencia del cliente.
      </p>
      <div class="hero-buttons">
        <button type="button" class="btn btn-navy" data-open-quote>
          Analizar mi empresa
        </button>
        <a href="#como-trabajamos" class="btn btn-outline">
          Ver cómo funciona
        </a>
      </div>
    </div>

    <div class="hero-visual" data-aos="fade-left" data-aos-delay="150">
      <!-- Network Nodes Canvas -->
      <div class="visual-canvas">
        <!-- SVG Connecting Lines -->
        <svg class="connections-svg" viewBox="0 0 500 450" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Animated Curved Connecting Lines -->
          <path d="M250 220 Q 150 140 100 130" stroke="#a7f3d0" stroke-width="2.5" stroke-dasharray="6 6" class="pulse-line" />
          <path d="M250 220 Q 210 100 230 70" stroke="#25d366" stroke-width="2.5" class="pulse-line" />
          <path d="M250 220 Q 330 110 320 70" stroke="#f59e0b" stroke-width="2.5" stroke-dasharray="6 6" class="pulse-line" />
          <path d="M250 220 Q 380 120 400 110" stroke="#10b981" stroke-width="2.5" class="pulse-line" />
          <path d="M250 220 Q 380 190 380 170" stroke="#3b82f6" stroke-width="2.5" stroke-dasharray="6 6" class="pulse-line" />
          <path d="M250 220 Q 390 260 380 230" stroke="#6366f1" stroke-width="2.5" class="pulse-line" />
          <path d="M250 220 Q 420 300 430 240" stroke="#06b6d4" stroke-width="2.5" stroke-dasharray="6 6" class="pulse-line" />
          <path d="M250 220 Q 370 360 380 340" stroke="#10b981" stroke-width="2.5" class="pulse-line" />
          <path d="M250 220 Q 280 370 310 350" stroke="#3b82f6" stroke-width="2.5" stroke-dasharray="6 6" class="pulse-line" />
          <path d="M250 220 Q 140 340 110 330" stroke="#60a5fa" stroke-width="2.5" class="pulse-line" />
        </svg>

        <!-- Central Robot -->
        <div class="central-robot">
          <div class="robot-glow"></div>
          <img src="/images/Robot.png" alt="Agente de IA MM SmartInbox" class="robot-img" />
        </div>

        <!-- Floating Badges around Robot -->
        <!-- CRM (Top Left) -->
        <div class="node-badge node-crm">
          <div class="node-icon bg-blue">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <span>CRM</span>
        </div>

        <!-- WhatsApp (Top Center) -->
        <div class="node-badge node-whatsapp">
          <div class="node-icon bg-whatsapp">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
          </div>
        </div>

        <!-- Email (Top Right) -->
        <div class="node-badge node-email">
          <div class="node-icon bg-gold">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <span>Email</span>
        </div>

        <!-- Documentos Top (Far Right) -->
        <div class="node-badge node-doc-top">
          <div class="node-icon bg-emerald">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <span>Documentos</span>
        </div>

        <!-- Calendario (Right) -->
        <div class="node-badge node-calendar">
          <div class="node-icon bg-amber">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <span>Calendario</span>
        </div>

        <!-- ERP (Mid Right) -->
        <div class="node-badge node-erp">
          <div class="node-icon bg-indigo">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <span>ERP</span>
        </div>

        <!-- APIs (Far Right) -->
        <div class="node-badge node-apis">
          <div class="node-card bg-white-card">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#3b82f6" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span class="bold-text">APIs</span>
          </div>
        </div>

        <!-- Google Sheets (Bottom Right) -->
        <div class="node-badge node-sheets">
          <div class="node-icon bg-sheets">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="3" y1="15" x2="21" y2="15"></line>
              <line x1="9" y1="3" x2="9" y2="21"></line>
            </svg>
          </div>
          <span>Google Sheets</span>
        </div>

        <!-- Bases de Datos (Bottom Center) -->
        <div class="node-badge node-db">
          <div class="node-icon bg-cyan">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M21 19c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14"></path>
              <path d="M21 5v14"></path>
            </svg>
          </div>
          <span>Bases de Datos</span>
        </div>

        <!-- Documentos Bottom (Bottom Left) -->
        <div class="node-badge node-doc-bottom">
          <div class="node-icon bg-sky">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <span>Documentos</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8faff 100%);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    max-width: 1280px;
    width: 92%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .hero-content {
    flex: 1;
    max-width: 580px;
  }

  .hero-title {
    font-size: 3.4rem;
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -1.2px;
    margin-bottom: 1.5rem;
  }

  .hero-description {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 2.2rem;
    font-weight: 400;
  }

  .hero-buttons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .btn {
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-navy {
    background-color: #0b2591;
    color: white;
    box-shadow: 0 4px 16px rgba(11, 37, 145, 0.28);
    border: none;
  }

  .btn-navy:hover {
    background-color: #061868;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(11, 37, 145, 0.38);
  }

  .btn-outline {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .btn-outline:hover {
    background-color: #f8fafc;
    border-color: #0b2591;
    color: #0b2591;
    transform: translateY(-2px);
  }

  /* Visual Graphic */
  .hero-visual {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    min-height: 440px;
  }

  .visual-canvas {
    position: relative;
    width: 520px;
    height: 440px;
  }

  .connections-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .pulse-line {
    animation: dashPulse 20s linear infinite;
  }

  @keyframes dashPulse {
    to {
      stroke-dashoffset: -100;
    }
  }

  .central-robot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    width: 220px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .robot-glow {
    position: absolute;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.25) 0%, rgba(59, 130, 246, 0.15) 50%, transparent 75%);
    filter: blur(15px);
    animation: glowPulse 4s ease-in-out infinite alternate;
  }

  @keyframes glowPulse {
    0% { transform: scale(0.9); opacity: 0.7; }
    100% { transform: scale(1.15); opacity: 1; }
  }

  .robot-img {
    width: 180px;
    height: auto;
    object-fit: contain;
    position: relative;
    z-index: 6;
    filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.12));
    animation: floatRobot 4s ease-in-out infinite alternate;
  }

  @keyframes floatRobot {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-10px); }
  }

  /* Node Badges */
  .node-badge {
    position: absolute;
    z-index: 10;
    background: #ffffff;
    padding: 0.4rem 0.8rem;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #1e293b;
    border: 1px solid #f1f5f9;
    transition: transform 0.3s ease;
  }

  .node-badge:hover {
    transform: scale(1.08);
  }

  .node-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
  }

  .bg-blue { background: #3b82f6; }
  .bg-whatsapp { background: #25d366; }
  .bg-gold { background: #f59e0b; }
  .bg-emerald { background: #10b981; }
  .bg-amber { background: #fbbf24; color: #1e293b; }
  .bg-indigo { background: #6366f1; }
  .bg-cyan { background: #06b6d4; }
  .bg-sheets { background: #10b981; }
  .bg-sky { background: #0284c7; }

  .node-card {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #f8fafc;
    padding: 0.4rem 0.9rem;
    border-radius: 8px;
    border: 1.5px solid #e2e8f0;
  }

  .bold-text {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0b2591;
    letter-spacing: 0.5px;
  }

  /* Node Positions matching original screenshot layout */
  .node-crm { top: 75px; left: 60px; }
  .node-whatsapp { top: 25px; left: 215px; }
  .node-email { top: 40px; left: 300px; }
  .node-doc-top { top: 85px; left: 380px; }
  .node-calendar { top: 145px; left: 350px; }
  .node-erp { top: 205px; left: 360px; }
  .node-apis { top: 230px; left: 425px; }
  .node-sheets { top: 320px; left: 350px; }
  .node-db { top: 345px; left: 230px; }
  .node-doc-bottom { top: 310px; left: 65px; }

  /* Responsive styling */
  @media (max-width: 1100px) {
    .hero-container {
      flex-direction: column;
      text-align: center;
    }
    .hero-content {
      max-width: 100%;
    }
    .hero-title {
      font-size: 2.6rem;
    }
    .hero-buttons {
      justify-content: center;
    }
    .hero-visual {
      width: 100%;
      min-height: 400px;
    }
    .visual-canvas {
      transform: scale(0.9);
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.1rem;
    }
    .hero-description {
      font-size: 1rem;
    }
    .hero-buttons {
      flex-direction: column;
      width: 100%;
    }
    .btn {
      width: 100%;
    }
    .visual-canvas {
      transform: scale(0.72);
      margin: -40px 0;
    }
  }
</style>
