---
// src/components/AgenteIAWorkflow.astro
---
<div id="agente-ia" class="section-card card-agente-workflow" data-aos="fade-up" data-aos-delay="100">
  <div class="section-header">
    <h2>Tu Agente de IA</h2>
    <p class="subtitle">Ejemplo simple de automatización inteligente</p>
  </div>

  <div class="workflow-container">
    <!-- Step 1: Recibe Consulta -->
    <div class="step-node">
      <div class="step-icon bg-user">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </div>
      <span class="step-label">Recibe Consulta</span>
    </div>

    <!-- Arrow 1 -->
    <div class="arrow-connector">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#94a3b8" stroke-width="2.5">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </div>

    <!-- Step 2: Analiza CRM (Central Robot) -->
    <div class="step-node robot-step">
      <div class="robot-avatar">
        <img src="/images/Robot.png" alt="Analiza CRM" />
      </div>
      <span class="step-label highlight-label">Analiza CRM</span>
    </div>

    <!-- Arrow 2 -->
    <div class="arrow-connector">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#94a3b8" stroke-width="2.5">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </div>

    <!-- Step 3: Actualiza CRM -->
    <div class="step-node">
      <div class="step-icon bg-database">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
          <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
          <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
        </svg>
      </div>
      <span class="step-label">Actualiza CRM</span>
    </div>

    <!-- Arrow 3 -->
    <div class="arrow-connector">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#94a3b8" stroke-width="2.5">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </div>

    <!-- Step 4: Informa al Equipo -->
    <div class="step-node">
      <div class="step-icon bg-team">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      </div>
      <span class="step-label">Informa al Equipo</span>
    </div>
  </div>
</div>

<style>
  .section-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.8rem;
  }

  .section-header h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    margin-bottom: 0.25rem;
  }

  .section-header .subtitle {
    font-size: 0.9rem;
    color: #64748b;
  }

  .workflow-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f8fafc;
    border-radius: 16px;
    padding: 1.5rem 1.25rem;
    border: 1px solid #f1f5f9;
  }

  .step-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
    flex: 1;
  }

  .step-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  .bg-user { background: #3b82f6; }
  .bg-database { background: #0b2591; }
  .bg-team { background: #10b981; }

  .robot-step {
    position: relative;
  }

  .robot-avatar {
    width: 70px;
    height: 70px;
    background: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px rgba(11, 37, 145, 0.15);
    border: 2px solid #0b2591;
    padding: 6px;
  }

  .robot-avatar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .step-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
  }

  .highlight-label {
    color: #0b2591;
    font-size: 0.9rem;
  }

  .arrow-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .workflow-container {
      flex-direction: column;
      gap: 1rem;
    }
    .arrow-connector {
      transform: rotate(90deg);
    }
  }
</style>
