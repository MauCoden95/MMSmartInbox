---
// src/components/CasosDeUsoGrid.astro
---
<div id="casos-de-uso" class="section-card card-casos-de-uso" data-aos="fade-up">
  <div class="section-header">
    <h2>Casos de Uso</h2>
    <p class="subtitle">Soluciones adaptadas a cada industria</p>
  </div>

  <div class="casos-grid">
    <!-- 1: Restaurantes -->
    <div class="caso-card">
      <div class="caso-thumb">
        <img src="/images/caso_restaurantes.png" alt="Restaurantes" />
      </div>
      <span class="caso-title">Restaurantes</span>
    </div>

    <!-- 2: Logística -->
    <div class="caso-card">
      <div class="caso-thumb">
        <img src="/images/caso_logistica.png" alt="Logística" />
      </div>
      <span class="caso-title">Logística</span>
    </div>

    <!-- 3: Constructoras -->
    <div class="caso-card">
      <div class="caso-thumb">
        <img src="/images/caso_constructoras.png" alt="Constructoras" />
      </div>
      <span class="caso-title">Constructoras</span>
    </div>

    <!-- 4: Odontólogos -->
    <div class="caso-card">
      <div class="caso-thumb icon-thumb bg-teal">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"></path>
          <path d="M12 6v12M6 12h12"></path>
        </svg>
      </div>
      <span class="caso-title">Odontólogos</span>
    </div>

    <!-- 5: Medicina -->
    <div class="caso-card">
      <div class="caso-thumb icon-thumb bg-blue-med">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
        </svg>
      </div>
      <span class="caso-title">Medicina</span>
    </div>

    <!-- 6: Odontología / Salud -->
    <div class="caso-card">
      <div class="caso-thumb icon-thumb bg-indigo-med">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
        </svg>
      </div>
      <span class="caso-title">Salud & Bienestar</span>
    </div>

    <!-- 7: Inmobiliarias -->
    <div class="caso-card">
      <div class="caso-thumb icon-thumb bg-amber-real">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </div>
      <span class="caso-title">Inmobiliarias</span>
    </div>

    <!-- 8: Estética -->
    <div class="caso-card">
      <div class="caso-thumb icon-thumb bg-pink-spa">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 8a4 4 0 0 0-4 4"></path>
        </svg>
      </div>
      <span class="caso-title">Estética & Spa</span>
    </div>

    <!-- 9: Automatización de tareas -->
    <div class="caso-card">
      <div class="caso-thumb icon-thumb bg-green-auto">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
        </svg>
      </div>
      <span class="caso-title">Automatización</span>
    </div>

    <!-- 10: + Personalizado -->
    <div class="caso-card add-custom" data-open-quote>
      <div class="caso-thumb icon-thumb bg-plus">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="3">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </div>
      <span class="caso-title bold-title">+ Personalizado</span>
    </div>
  </div>
</div>

<style>
  .section-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 2.2rem 2rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.8rem;
  }

  .section-header h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    margin-bottom: 0.25rem;
  }

  .section-header .subtitle {
    font-size: 0.9rem;
    color: #64748b;
  }

  .casos-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .caso-card {
    background: #f8fafc;
    border-radius: 12px;
    padding: 0.8rem;
    border: 1px solid #f1f5f9;
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .caso-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.06);
    border-color: #cbd5e1;
  }

  .caso-thumb {
    width: 100%;
    height: 70px;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .caso-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .icon-thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .bg-teal { background: #14b8a6; }
  .bg-blue-med { background: #0284c7; }
  .bg-indigo-med { background: #6366f1; }
  .bg-amber-real { background: #f59e0b; }
  .bg-pink-spa { background: #ec4899; }
  .bg-green-auto { background: #10b981; }
  .bg-plus { background: #e2e8f0; color: #0b2591; }

  .caso-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #1e293b;
  }

  .bold-title {
    color: #0b2591;
  }

  .add-custom:hover .bg-plus {
    background: #0b2591;
    color: white;
  }

  @media (max-width: 900px) {
    .casos-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .casos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
