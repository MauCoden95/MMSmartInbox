---
// src/components/PropuestaValor.astro
---
<div id="propuesta-valor" class="section-card card-propuesta" data-aos="fade-up">
  <div class="section-header">
    <h2>Propuesta de Valor</h2>
    <p class="subtitle">Implementamos IA aplicada y automatización inteligente para potenciar tus resultados</p>
  </div>

  <div class="value-flow">
    <!-- Step 1: Problema -->
    <div class="flow-box border-red">
      <div class="box-icon icon-red">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </div>
      <h3>Problema</h3>
    </div>

    <!-- Arrow -->
    <div class="flow-arrow">➔</div>

    <!-- Step 2: Análisis -->
    <div class="flow-box border-purple">
      <div class="box-icon icon-purple">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <h3>Análisis</h3>
    </div>

    <!-- Arrow -->
    <div class="flow-arrow">➔</div>

    <!-- Step 3: IA/Automatización -->
    <div class="flow-box border-blue">
      <div class="box-icon icon-blue">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="10" rx="2"></rect>
          <circle cx="12" cy="5" r="2"></circle>
          <path d="M12 7v4"></path>
          <line x1="8" y1="16" x2="8" y2="16"></line>
          <line x1="16" y1="16" x2="16" y2="16"></line>
        </svg>
      </div>
      <h3>IA/Automatación</h3>
    </div>

    <!-- Arrow -->
    <div class="flow-arrow">➔</div>

    <!-- Step 4: Real-Business Result -->
    <div class="flow-box border-green">
      <div class="box-icon icon-green">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
      </div>
      <h3>Real-Business Result</h3>
    </div>
  </div>
</div>

<style>
  .section-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.8rem;
  }

  .section-header h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.5px;
    margin-bottom: 0.25rem;
  }

  .section-header .subtitle {
    font-size: 0.9rem;
    color: #64748b;
  }

  .value-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .flow-box {
    flex: 1;
    background: #ffffff;
    border-radius: 14px;
    padding: 1.25rem 0.8rem;
    text-align: center;
    border: 1.5px solid #e2e8f0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .flow-box:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.07);
  }

  .box-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.6rem;
  }

  .icon-red { background: #fee2e2; color: #ef4444; }
  .icon-purple { background: #f3e8ff; color: #a855f7; }
  .icon-blue { background: #dbeafe; color: #3b82f6; }
  .icon-green { background: #dcfce7; color: #15c63b; }

  .border-red:hover { border-color: #ef4444; }
  .border-purple:hover { border-color: #a855f7; }
  .border-blue:hover { border-color: #3b82f6; }
  .border-green:hover { border-color: #15c63b; }

  .flow-box h3 {
    font-size: 0.88rem;
    font-weight: 700;
    color: #1e293b;
  }

  .flow-arrow {
    font-size: 1.2rem;
    color: #94a3b8;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .value-flow {
      flex-direction: column;
    }
    .flow-arrow {
      transform: rotate(90deg);
    }
    .flow-box {
      width: 100%;
    }
  }
</style>
