---
// src/components/demo/CRMPreview.astro
---

<section class="crm-preview-section" id="crm-section">
  <div class="crm-container">
    <div class="section-header text-center">
      <span class="step-badge">Etapa 5</span>
      <h2 class="section-title">El agente no solamente conversa.</h2>
      <p class="section-subtitle">
        Cada interacción calificada genera automáticamente un registro limpio en el CRM de tu empresa con todos los datos clave extraídos.
      </p>
    </div>

    <!-- SaaS CRM Interface Preview Card -->
    <div class="crm-window">
      <div class="crm-header-bar">
        <div class="crm-title-group">
          <div class="crm-logo-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <span class="crm-app-title">MM SmartInbox CRM • Vista de Oportunidades</span>
        </div>
        <div class="crm-filter-badge">
          <span>Actualizado en tiempo real por el Agente</span>
        </div>
      </div>

      <div class="crm-body">
        <div class="record-card updated" id="crm-record-card">
          <div class="record-badge-new" id="crm-new-badge">NUEVO LEAD REGISTRADO</div>
          
          <div class="record-main-info">
            <div class="user-avatar-circle" id="crm-avatar">MG</div>
            <div class="user-name-box">
              <h3 class="client-name" id="crm-name">Martín González</h3>
              <span class="client-phone" id="crm-phone">+54 9 11 4589-2231</span>
            </div>
            <div class="status-pill" id="crm-status-pill">
              <span class="status-dot"></span>
              <span id="crm-status-text">Lead Calificado</span>
            </div>
          </div>

          <div class="record-grid-details">
            <div class="detail-box">
              <span class="detail-label">Interés / Solicitud:</span>
              <span class="detail-value" id="crm-interest">Depto 2 ambientes en Palermo/Belgrano</span>
            </div>

            <div class="detail-box">
              <span class="detail-label">Presupuesto / Valor:</span>
              <span class="detail-value highlight" id="crm-details">USD 120.000 (Balcón corrido)</span>
            </div>

            <div class="detail-box">
              <span class="detail-label">Próximo paso automático:</span>
              <span class="detail-value step-next" id="crm-next-step">Coordinar visita presencial</span>
            </div>

            <div class="detail-box">
              <span class="detail-label">Origen de la captura:</span>
              <span class="detail-value origin-tag" id="crm-source">Agente IA Inmobiliario</span>
            </div>
          </div>

          <div class="record-footer">
            <span class="timestamp-text">Registrado automáticamente hace 5 segundos</span>
            <div class="action-buttons">
              <button class="btn-crm-action">Ver ficha completa</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .crm-preview-section {
    padding: 4rem 1.5rem;
    background: #ffffff;
  }
  .crm-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-header.text-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 2.5rem;
  }
  .step-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: #f1f5f9;
    color: var(--color-text-medium);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-text-dark);
    margin-bottom: 0.75rem;
  }
  .section-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-medium);
    line-height: 1.6;
  }

  .crm-window {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 16px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
    overflow: hidden;
  }
  .crm-header-bar {
    background: #0f172a;
    color: #ffffff;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .crm-title-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .crm-logo-icon {
    color: var(--color-primary-blue);
  }
  .crm-app-title {
    font-size: 0.9rem;
    font-weight: 700;
  }
  .crm-filter-badge {
    font-size: 0.78rem;
    color: var(--color-primary-green);
    background: rgba(21, 198, 59, 0.15);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-weight: 600;
  }

  .crm-body {
    padding: 1.75rem;
    background: #f8fafc;
  }

  .record-card {
    background: #ffffff;
    border: 2px solid var(--color-primary-blue);
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: 0 8px 24px rgba(58, 61, 238, 0.08);
    position: relative;
    transition: all 0.4s ease;
  }
  .record-card.updated {
    animation: crmPulse 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes crmPulse {
    0% { transform: scale(0.98); opacity: 0.8; }
    50% { transform: scale(1.01); }
    100% { transform: scale(1); opacity: 1; }
  }

  .record-badge-new {
    position: absolute;
    top: -12px;
    right: 20px;
    background: var(--color-primary-green);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 10px rgba(21, 198, 59, 0.3);
  }

  .record-main-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .user-avatar-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-primary-blue);
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .user-name-box {
    flex-grow: 1;
  }
  .client-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-dark);
    margin-bottom: 0.15rem;
  }
  .client-phone {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(21, 198, 59, 0.1);
    color: var(--color-primary-green);
    border: 1px solid rgba(21, 198, 59, 0.3);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary-green);
  }

  .record-grid-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .detail-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: #f8fafc;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
  }
  .detail-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-light);
  }
  .detail-value {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }
  .detail-value.highlight {
    color: var(--color-primary-blue);
  }
  .detail-value.step-next {
    color: #d97706;
  }
  .detail-value.origin-tag {
    color: #16a34a;
  }

  .record-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid #f1f5f9;
  }
  .timestamp-text {
    font-size: 0.78rem;
    color: var(--color-text-light);
    font-style: italic;
  }
  .btn-crm-action {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: var(--color-text-dark);
    padding: 0.35rem 0.85rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .record-main-info {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const card = document.getElementById('crm-record-card');
    const nameEl = document.getElementById('crm-name');
    const phoneEl = document.getElementById('crm-phone');
    const statusTextEl = document.getElementById('crm-status-text');
    const interestEl = document.getElementById('crm-interest');
    const detailsEl = document.getElementById('crm-details');
    const nextStepEl = document.getElementById('crm-next-step');
    const sourceEl = document.getElementById('crm-source');
    const avatarEl = document.getElementById('crm-avatar');

    window.addEventListener('demo:crm-update', (e: Event) => {
      const customEvent = e as CustomEvent;
      const data = customEvent.detail;
      if (!data) return;

      if (nameEl) nameEl.textContent = data.name || 'Cliente Registrar';
      if (phoneEl) phoneEl.textContent = data.phone || '+54 9 11 4000-0000';
      if (statusTextEl) statusTextEl.textContent = data.status || 'Lead Calificado';
      if (interestEl) interestEl.textContent = data.interest || 'Consulta General';
      if (detailsEl) detailsEl.textContent = data.details || '-';
      if (nextStepEl) nextStepEl.textContent = data.nextStep || 'Seguimiento Automático';
      if (sourceEl) sourceEl.textContent = data.source || 'Agente IA MM SmartInbox';

      if (avatarEl && data.name) {
        avatarEl.textContent = data.name.substring(0, 2).toUpperCase();
      }

      if (card) {
        card.classList.remove('updated');
        void card.offsetWidth; // trigger reflow
        card.classList.add('updated');
      }
    });
  });
</script>
