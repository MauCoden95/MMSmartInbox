---
// src/components/demo/WorkflowVisualization.astro
---

<section class="workflow-section" id="workflow-section">
  <div class="workflow-container">
    <div class="section-header text-center">
      <span class="step-badge">Etapa 4</span>
      <h2 class="section-title">Esto no terminó en el chat.</h2>
      <p class="section-subtitle">
        El agente se conecta directamente con los sistemas que tu empresa ya utiliza para convertir cada conversación en un proceso comercial automatizado.
      </p>
    </div>

    <!-- Interactive Animated Node Workflow -->
    <div class="workflow-diagram-card">
      <div class="nodes-container">
        
        <!-- Node 1: WhatsApp / Entrada -->
        <div class="workflow-node node-trigger active">
          <div class="node-icon-wrapper whatsapp">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </div>
          <div class="node-info">
            <span class="node-title">Cliente / Mensaje</span>
            <span class="node-sub">WhatsApp • IG • Web</span>
          </div>
        </div>

        <div class="node-connector active">
          <div class="connector-line"></div>
          <div class="connector-pulse"></div>
        </div>

        <!-- Node 2: Agente IA -->
        <div class="workflow-node node-ai active">
          <div class="node-icon-wrapper ai">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <div class="node-info">
            <span class="node-title">Agente IA Nova</span>
            <span class="node-sub">Motor de decisión</span>
          </div>
        </div>

        <div class="node-connector active">
          <div class="connector-line"></div>
          <div class="connector-pulse"></div>
        </div>

        <!-- Node 3: Base de Conocimiento -->
        <div class="workflow-node node-kb">
          <div class="node-icon-wrapper kb">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
          </div>
          <div class="node-info">
            <span class="node-title">Base de Datos</span>
            <span class="node-sub">Stock • Catálogo • Docs</span>
          </div>
        </div>

        <div class="node-connector">
          <div class="connector-line"></div>
          <div class="connector-pulse"></div>
        </div>

        <!-- Node 4: CRM -->
        <div class="workflow-node node-crm">
          <div class="node-icon-wrapper crm">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <div class="node-info">
            <span class="node-title">Sistema CRM</span>
            <span class="node-sub">Lead • Pipeline</span>
          </div>
        </div>

        <div class="node-connector">
          <div class="connector-line"></div>
          <div class="connector-pulse"></div>
        </div>

        <!-- Node 5: Calendario / Agenda -->
        <div class="workflow-node node-calendar">
          <div class="node-icon-wrapper calendar">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </div>
          <div class="node-info">
            <span class="node-title">Agenda / Turnos</span>
            <span class="node-sub">Google Cal • ERP</span>
          </div>
        </div>

        <div class="node-connector">
          <div class="connector-line"></div>
          <div class="connector-pulse"></div>
        </div>

        <!-- Node 6: Notificaciones & Seguimiento -->
        <div class="workflow-node node-notify">
          <div class="node-icon-wrapper notify">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </div>
          <div class="node-info">
            <span class="node-title">Seguimiento</span>
            <span class="node-sub">Alertas al equipo</span>
          </div>
        </div>

      </div>

      <div class="workflow-footer-banner">
        <div class="banner-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        </div>
        <p>
          "El agente puede conectarse con las herramientas que tu empresa ya utiliza para convertir una conversación en un proceso automatizado completo."
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .workflow-section {
    padding: 4rem 1.5rem;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }
  .workflow-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-header.text-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3rem;
  }
  .step-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: var(--color-text-medium);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-text-dark);
    margin-bottom: 0.75rem;
  }
  .section-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-medium);
    line-height: 1.6;
  }

  .workflow-diagram-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2.5rem 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .nodes-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 1.5rem;
  }

  .workflow-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 120px;
    padding: 0.75rem;
    border-radius: 12px;
    transition: all 0.3s;
  }
  .workflow-node.active {
    background: rgba(58, 61, 238, 0.04);
  }

  .node-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
    background: #f1f5f9;
    color: var(--color-text-medium);
    box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    transition: all 0.3s;
  }
  .node-icon-wrapper.whatsapp { background: #dcfce7; color: #16a34a; }
  .node-icon-wrapper.ai { background: var(--color-primary-blue); color: #ffffff; }
  .node-icon-wrapper.kb { background: #e0f2fe; color: #0284c7; }
  .node-icon-wrapper.crm { background: #fef3c7; color: #d97706; }
  .node-icon-wrapper.calendar { background: #f3e8ff; color: #9333ea; }
  .node-icon-wrapper.notify { background: #dcfce7; color: #15C63B; }

  .node-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-text-dark);
    display: block;
    margin-bottom: 0.2rem;
  }
  .node-sub {
    font-size: 0.75rem;
    color: var(--color-text-light);
    display: block;
  }

  .node-connector {
    position: relative;
    flex-grow: 1;
    height: 2px;
    background: #cbd5e1;
    min-width: 30px;
  }
  .node-connector.active {
    background: var(--color-primary-blue);
  }
  .connector-pulse {
    position: absolute;
    top: -3px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary-green);
    animation: flowPulse 2s infinite linear;
  }
  @keyframes flowPulse {
    0% { left: 0%; opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  .workflow-footer-banner {
    margin-top: 2rem;
    padding: 1rem 1.5rem;
    background: rgba(58, 61, 238, 0.05);
    border: 1px solid rgba(58, 61, 238, 0.15);
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .banner-icon {
    color: var(--color-primary-blue);
    flex-shrink: 0;
  }
  .workflow-footer-banner p {
    font-size: 0.95rem;
    color: var(--color-text-dark);
    font-style: italic;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .nodes-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .node-connector {
      width: 2px;
      height: 30px;
      margin-left: 25px;
      min-width: auto;
    }
    .connector-pulse {
      animation: flowPulseVertical 2s infinite linear;
    }
    @keyframes flowPulseVertical {
      0% { top: 0%; opacity: 1; }
      100% { top: 100%; opacity: 0; }
    }
    .workflow-node {
      flex-direction: row;
      gap: 1rem;
      text-align: left;
    }
  }
</style>
