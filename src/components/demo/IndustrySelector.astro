---
// src/components/demo/IndustrySelector.astro
import { DEMO_INDUSTRIES } from '../../data/demo/demoIndustries.js';
---

<section class="industry-selector-section" id="industry-selector">
  <div class="section-header">
    <span class="step-badge">Etapa 2</span>
    <h2 class="section-title">¿Qué tipo de negocio querés simular?</h2>
    <p class="section-subtitle">
      Seleccioná una industria para ver cómo el agente adapta su contexto, consulta datos específicos y ejecuta acciones correspondientes.
    </p>
  </div>

  <div class="industry-grid">
    {DEMO_INDUSTRIES.map((ind, index) => (
      <button 
        class={`industry-card ${index === 0 ? 'active' : ''}`}
        data-industry-id={ind.id}
        type="button"
      >
        <div class="card-badge">{ind.badge}</div>
        <div class="card-icon-box">
          {ind.icon === 'building' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg>
          )}
          {ind.icon === 'utensils' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2v20"></path><path d="M18 2a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3"></path><path d="M14 2v7a2 2 0 0 0 2 2h2"></path><path d="M6 2v7a2 2 0 0 0 2 2h2V2"></path><path d="M8 11v11"></path></svg>
          )}
          {ind.icon === 'hospital' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6v12"></path><path d="M6 12h12"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
          )}
          {ind.icon === 'bed' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4v16"></path><path d="M2 8h18a2 2 0 0 1 2 2v10"></path><path d="M2 17h20"></path><path d="M6 8v9"></path></svg>
          )}
          {ind.icon === 'shopping-cart' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          )}
          {ind.icon === 'briefcase' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          )}
          {ind.icon === 'gift' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
          )}
          {ind.icon === 'scissors' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><line x1="20" y1="4" x2="8.12" y2="15.88"></line><line x1="14.47" y1="14.47" x2="20" y2="20"></line><line x1="8.12" y1="8.12" x2="12" y2="12"></line></svg>
          )}
          {ind.icon === 'activity' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 14 22 10 2 6 12 2 12"></polyline></svg>
          )}
          {ind.icon === 'paw' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.5c-1.8 0-3.3-1-4.2-2.5C7.2 14.1 7 13.1 7 12c0-2.8 2.2-5 5-5s5 2.2 5 5c0 1.1-.2 2.1-.8 3-1 1.5-2.4 2.5-4.2 2.5z"></path><circle cx="6" cy="7" r="2"></circle><circle cx="10" cy="4" r="2"></circle><circle cx="14" cy="4" r="2"></circle><circle cx="18" cy="7" r="2"></circle></svg>
          )}
          {ind.icon === 'car' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path><circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle></svg>
          )}
          {ind.icon === 'scale' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h18"></path></svg>
          )}
        </div>
        <h3 class="card-name">{ind.name}</h3>
        <p class="card-subtitle">{ind.subtitle}</p>
        
        <div class="card-select-indicator">
          <span class="indicator-dot"></span>
          <span class="indicator-text">Seleccionado</span>
        </div>
      </button>
    ))}
  </div>
</section>

<style>
  .industry-selector-section {
    padding: 3rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 2.5rem;
  }
  .step-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: #f1f5f9;
    color: var(--color-text-medium);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-dark);
    margin-bottom: 0.75rem;
  }
  .section-subtitle {
    font-size: 1rem;
    color: var(--color-text-medium);
    line-height: 1.5;
  }

  .industry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .industry-card {
    position: relative;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.5rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .industry-card:hover {
    border-color: var(--color-primary-blue);
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(58, 61, 238, 0.08);
  }
  .industry-card.active {
    border-color: var(--color-primary-blue);
    background-color: rgba(58, 61, 238, 0.02);
    box-shadow: 0 8px 20px rgba(58, 61, 238, 0.12);
  }

  .card-badge {
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }
  .industry-card.active .card-badge {
    background: rgba(58, 61, 238, 0.1);
    color: var(--color-primary-blue);
    border-color: rgba(58, 61, 238, 0.2);
  }

  .card-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: #f1f5f9;
    color: var(--color-text-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    transition: all 0.2s;
  }
  .industry-card.active .card-icon-box {
    background: var(--color-primary-blue);
    color: #ffffff;
  }

  .card-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-dark);
    margin-bottom: 0.5rem;
  }
  .card-subtitle {
    font-size: 0.88rem;
    color: var(--color-text-medium);
    line-height: 1.4;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .card-select-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-light);
    opacity: 0.6;
  }
  .indicator-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cbd5e1;
  }
  .industry-card.active .card-select-indicator {
    color: var(--color-primary-blue);
    opacity: 1;
  }
  .industry-card.active .indicator-dot {
    background: var(--color-primary-green);
    box-shadow: 0 0 0 3px rgba(21, 198, 59, 0.2);
  }
</style>
