---
// src/components/Header.astro
---
<div class="header-wrapper" id="header-wrapper" transition:persist="main-header">
  <header class="header">
    <a href="/" class="logo">
      <img src="/images/Logo.png" alt="MM SmartInbox" />
    </a>
    <nav class="nav" id="nav-menu">
      <a href="/#inicio">Inicio</a>
      <a href="/nosotros">Nosotros</a>

      <!-- Dropdown Soluciones -->
      <div class="nav-dropdown" id="solutions-dropdown">
        <button class="nav-dropdown-trigger" id="solutions-trigger" type="button" aria-expanded="false" aria-haspopup="true">
          <span>Soluciones</span>
          <svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="mega-menu" id="solutions-menu">
          <div class="mega-menu-inner">
            <!-- Columna Izquierda: Perfiles / Modalidad -->
            <div class="mega-col-left">
              <!-- Solución Enterprise (destacada estilo tarjeta) -->
              <a href="/#precios" class="mega-card-enterprise">
                <div class="mega-icon-wrap icon-navy">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#070caf" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                </div>
                <div class="mega-item-info">
                  <span class="mega-item-title">Solución Enterprise</span>
                  <span class="mega-item-desc">¿Construyendo para empresas de gran escala?</span>
                </div>
              </a>

              <!-- Solución para Agencias -->
              <a href="/#como-trabajamos" class="mega-item-side">
                <div class="mega-icon-wrap icon-navy">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#070caf" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                    <circle cx="12" cy="5" r="2"></circle>
                    <path d="M12 7v4"></path>
                    <line x1="8" y1="16" x2="8" y2="16"></line>
                    <line x1="16" y1="16" x2="16" y2="16"></line>
                  </svg>
                </div>
                <div class="mega-item-info">
                  <span class="mega-item-title">Solución para Agencias</span>
                  <span class="mega-item-desc">Construyendo para agencias y revendedores.</span>
                </div>
              </a>

              <!-- Hablar con un experto -->
              <button type="button" class="mega-item-side btn-reset" data-open-quote>
                <div class="mega-icon-wrap icon-navy">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#070caf" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 15h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 17"></path>
                    <path d="m7 21 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.8-2.8l-2.6 2.6"></path>
                    <path d="m2 13 3.3-3.3a2 2 0 0 1 2.8 0l1.9 1.9"></path>
                    <path d="m18 10 3.3-3.3a2 2 0 0 0-2.8-2.8l-3.5 3.5"></path>
                  </svg>
                </div>
                <div class="mega-item-info">
                  <span class="mega-item-title">Hablar con un experto</span>
                  <span class="mega-item-desc">Habla con un especialista para crear tu Agente de IA.</span>
                </div>
              </button>
            </div>

            <!-- Divisor Vertical -->
            <div class="mega-divider"></div>

            <!-- Columna Derecha: Industrias en Grid -->
            <div class="mega-col-right">
              <div class="mega-industries-grid">
                <!-- Ecommerce -->
                <a href="/soluciones/agente-ia-ecommerce" class="mega-industry-item">
                  <div class="mega-icon-wrap">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#72e475" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="8" cy="21" r="1"></circle>
                      <circle cx="19" cy="21" r="1"></circle>
                      <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                    </svg>
                  </div>
                  <div class="mega-item-info">
                    <span class="mega-item-title">Ecommerce</span>
                    <span class="mega-item-desc">Agente de IA sin necesidad de programar.</span>
                  </div>
                </a>

                <!-- Restaurantes -->
                <a href="/#casos-de-uso" class="mega-industry-item">
                  <div class="mega-icon-wrap">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#72e475" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 16a6 6 0 0 0-12 0Z"></path>
                      <line x1="2" y1="16" x2="22" y2="16"></line>
                      <line x1="12" y1="6" x2="12" y2="10"></line>
                      <circle cx="12" cy="5" r="1" fill="#72e475"></circle>
                      <line x1="4" y1="20" x2="20" y2="20"></line>
                    </svg>
                  </div>
                  <div class="mega-item-info">
                    <span class="mega-item-title">Restaurantes</span>
                    <span class="mega-item-desc">Agente de IA para atención y reservas en tiempo real.</span>
                  </div>
                </a>

                <!-- Banca y Finanzas -->
                <a href="/#casos-de-uso" class="mega-industry-item">
                  <div class="mega-icon-wrap">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#72e475" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="3" y1="21" x2="21" y2="21"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                      <path d="M5 10v11"></path>
                      <path d="M19 10v11"></path>
                      <path d="M10 10v11"></path>
                      <path d="M14 10v11"></path>
                      <path d="M12 2 3 7h18l-9-5Z"></path>
                    </svg>
                  </div>
                  <div class="mega-item-info">
                    <span class="mega-item-title">Banca y Finanzas</span>
                    <span class="mega-item-desc">Agente de IA para banca y finanzas.</span>
                  </div>
                </a>

                <!-- Logística -->
                <a href="/#casos-de-uso" class="mega-industry-item">
                  <div class="mega-icon-wrap">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#72e475" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="1" y="3" width="15" height="13"></rect>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                      <circle cx="5.5" cy="18.5" r="2.5"></circle>
                      <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                  </div>
                  <div class="mega-item-info">
                    <span class="mega-item-title">Logística</span>
                    <span class="mega-item-desc">Agente de IA para rastreo y soporte de envíos.</span>
                  </div>
                </a>

                <!-- Bienes Raíces -->
                <a href="/demo?industry=inmobiliaria" class="mega-industry-item">
                  <div class="mega-icon-wrap">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#72e475" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 9.5L12 3l9 6.5"></path>
                      <path d="M19 13v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6"></path>
                      <line x1="12" y1="11" x2="12" y2="17"></line>
                      <line x1="9" y1="14" x2="15" y2="14"></line>
                    </svg>
                  </div>
                  <div class="mega-item-info">
                    <span class="mega-item-title">Bienes Raíces</span>
                    <span class="mega-item-desc">Agente de IA para bienes raíces y propiedades.</span>
                  </div>
                </a>

                <!-- Salud y Clínicas -->
                <a href="/#casos-de-uso" class="mega-industry-item">
                  <div class="mega-icon-wrap">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#72e475" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                    </svg>
                  </div>
                  <div class="mega-item-info">
                    <span class="mega-item-title">Salud y Clínicas</span>
                    <span class="mega-item-desc">Agente de IA para centros de salud y turnos.</span>
                  </div>
                </a>
              </div>

              <!-- Footer "Ver todas las soluciones ↗" -->
              <div class="mega-col-footer">
                <a href="/#casos-de-uso" class="mega-view-all">
                  <span>Ver todas las soluciones</span>
                  <span class="arrow-up-right">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <a href="/#automatizaciones">Automatizaciones</a>
      <a href="/#casos-de-uso">Casos de uso</a>
      <a href="/#como-trabajamos">Cómo trabajamos</a>
      <a href="/#precios">Precios</a>
      <div class="mobile-cta">
        <button class="btn btn-navy" data-open-quote>Solicitar cotización</button>
      </div>
    </nav>
    <div class="actions">
      <button class="btn btn-navy" data-open-quote>Solicitar cotización</button>
    </div>
    <button class="mobile-toggle" id="mobile-toggle" aria-label="Abrir menú">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </header>
</div>

<script>
  function initHeader() {
    const wrapper = document.getElementById('header-wrapper');
    const toggle = document.getElementById('mobile-toggle');
    const nav = document.getElementById('nav-menu');
    const solutionsDropdown = document.getElementById('solutions-dropdown');
    const solutionsTrigger = document.getElementById('solutions-trigger');

    // Reset mobile nav & dropdown on navigation
    nav?.classList.remove('active');
    solutionsDropdown?.classList.remove('mobile-open', 'is-open');

    function updateShadow() {
      if (window.scrollY > 10) {
        wrapper?.classList.add('scrolled');
      } else {
        wrapper?.classList.remove('scrolled');
      }
    }
    window.removeEventListener('scroll', updateShadow);
    window.addEventListener('scroll', updateShadow, { passive: true });
    updateShadow();

    if (toggle) {
      toggle.onclick = () => {
        nav?.classList.toggle('active');
      };
    }

    if (solutionsTrigger && solutionsDropdown) {
      solutionsTrigger.onclick = (e) => {
        e.stopPropagation();
        if (window.innerWidth <= 900) {
          solutionsDropdown.classList.toggle('mobile-open');
        } else {
          solutionsDropdown.classList.toggle('is-open');
        }
      };

      // Close dropdown when clicking outside on desktop
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!solutionsDropdown.contains(target)) {
          solutionsDropdown.classList.remove('is-open');
        }
      });

      // Close on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          solutionsDropdown.classList.remove('is-open');
        }
      });
    }

    // Close nav on click of any action/link (except trigger itself)
    nav?.querySelectorAll('a, button[data-open-quote]').forEach(link => {
      link.addEventListener('click', () => {
        nav?.classList.remove('active');
        solutionsDropdown?.classList.remove('mobile-open', 'is-open');
      });
    });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .header-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 0 0 0 transparent;
    transition: all 0.3s ease;
    border-bottom: 1px solid #f1f5f9;
  }
  .header-wrapper.scrolled {
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 0;
    max-width: 1280px;
    width: 92%;
    margin: 0 auto;
    font-family: 'Inter', sans-serif;
    position: relative;
  }
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .logo img {
    height: 52px;
    width: auto;
    object-fit: contain;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }
  .nav a {
    text-decoration: none;
    color: #1e293b;
    font-weight: 600;
    font-size: 0.92rem;
    transition: color 0.2s ease;
    position: relative;
  }
  .nav a:hover {
    color: #0b2591;
  }

  /* Dropdown Soluciones */
  .nav-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .nav-dropdown-trigger {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.92rem;
    color: #1e293b;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.2s ease;
  }
  .nav-dropdown-trigger:hover,
  .nav-dropdown:hover .nav-dropdown-trigger,
  .nav-dropdown.is-open .nav-dropdown-trigger {
    color: #0b2591;
  }
  .chevron-icon {
    transition: transform 0.25s ease;
  }
  .nav-dropdown:hover .chevron-icon,
  .nav-dropdown.is-open .chevron-icon {
    transform: rotate(180deg);
  }

  /* Mega Menu Popover */
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-35%) translateY(10px);
    width: 790px;
    padding-top: 16px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 1050;
  }
  .nav-dropdown:hover .mega-menu,
  .nav-dropdown.is-open .mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-35%) translateY(0);
  }

  .mega-menu-inner {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.12), 0 0 1px 1px rgba(0, 0, 0, 0.04);
    padding: 1.4rem;
    display: flex;
    gap: 1.4rem;
  }

  /* Columna Izquierda */
  .mega-col-left {
    width: 275px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mega-card-enterprise {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.95rem 1rem;
    border-radius: 12px;
    border: 1.5px solid rgba(7, 12, 175, 0.25);
    background: #ffffff;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .mega-card-enterprise:hover {
    background: #f8faff;
    border-color: #070caf;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(7, 12, 175, 0.12);
  }

  .mega-item-side {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.75rem 0.85rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    text-align: left;
    width: 100%;
  }
  .mega-item-side:hover {
    background: #f8fafc;
    border-color: #f1f5f9;
    transform: translateY(-1px);
  }
  .btn-reset {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  /* Divisor */
  .mega-divider {
    width: 1px;
    background-color: #f1f5f9;
    align-self: stretch;
  }

  /* Columna Derecha */
  .mega-col-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .mega-industries-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1rem;
  }

  .mega-industry-item {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }
  .mega-industry-item:hover {
    background: #f8fafc;
    border-color: #f1f5f9;
    transform: translateY(-1px);
  }

  /* Iconos en Verde #72e475 y Azul #070caf */
  .mega-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(114, 228, 117, 0.12);
    color: #72e475;
    margin-top: 1px;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .mega-icon-wrap.icon-navy {
    background: rgba(7, 12, 175, 0.08);
    color: #070caf;
  }
  .mega-icon-wrap svg {
    display: block;
  }
  .mega-industry-item:hover .mega-icon-wrap {
    transform: scale(1.08);
    background: rgba(114, 228, 117, 0.22);
  }
  .mega-item-side:hover .mega-icon-wrap.icon-navy,
  .mega-card-enterprise:hover .mega-icon-wrap.icon-navy {
    transform: scale(1.08);
    background: rgba(7, 12, 175, 0.16);
  }

  /* Textos */
  .mega-item-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .mega-item-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
    transition: color 0.2s ease;
  }
  .mega-card-enterprise:hover .mega-item-title,
  .mega-industry-item:hover .mega-item-title,
  .mega-item-side:hover .mega-item-title {
    color: #0b2591;
  }
  .mega-item-desc {
    font-size: 0.78rem;
    font-weight: 400;
    color: #64748b;
    line-height: 1.35;
  }

  /* Footer "Ver todas las soluciones ↗" */
  .mega-col-footer {
    padding-top: 0.85rem;
    margin-top: 0.5rem;
    border-top: 1px solid #f8fafc;
    padding-left: 0.75rem;
  }
  .mega-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #475569;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .mega-view-all:hover {
    color: #0b2591;
    transform: translateX(2px);
  }
  .mega-view-all .arrow-up-right {
    font-size: 0.95rem;
    transition: transform 0.2s ease;
  }
  .mega-view-all:hover .arrow-up-right {
    transform: translate(2px, -2px);
  }

  /* Actions & Buttons */
  .actions {
    display: flex;
    align-items: center;
  }
  .btn.btn-navy {
    background-color: #0b2591;
    color: white;
    padding: 0.65rem 1.4rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(11, 37, 145, 0.25);
    border: none;
    cursor: pointer;
    font-family: inherit;
    letter-spacing: -0.2px;
  }
  .btn.btn-navy:hover {
    background-color: #061868;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(11, 37, 145, 0.35);
  }
  
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: #0b2591;
    cursor: pointer;
    padding: 0.5rem;
  }
  
  .mobile-cta {
    display: none;
  }

  @media (max-width: 1180px) and (min-width: 901px) {
    .header {
      padding: 0.8rem 0;
    }
    .logo img {
      height: 44px;
    }
    .nav {
      gap: 1.1rem;
    }
    .nav a,
    .nav-dropdown-trigger {
      font-size: 0.84rem;
    }
    .btn.btn-navy {
      padding: 0.55rem 1rem;
      font-size: 0.82rem;
    }
    .mega-menu {
      width: 710px;
      transform: translateX(-40%) translateY(10px);
    }
    .nav-dropdown:hover .mega-menu,
    .nav-dropdown.is-open .mega-menu {
      transform: translateX(-40%) translateY(0);
    }
    .mega-col-left {
      width: 240px;
    }
  }

  @media (max-width: 900px) {
    .actions {
      display: none;
    }
    .logo img {
      height: 44px;
    }
    .mobile-toggle {
      display: block;
    }
    .header {
      padding: 0.8rem 0;
    }
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: white;
      flex-direction: column;
      gap: 0;
      padding: 0;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
      clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
      transition: clip-path 0.3s ease-in-out;
      max-height: 85vh;
      overflow-y: auto;
    }
    .nav.active {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      border-top: 1px solid #f1f5f9;
    }
    .nav a:not(.btn):not(.mega-view-all):not(.mega-card-enterprise):not(.mega-item-side):not(.mega-industry-item) {
      padding: 1rem 1.8rem;
      border-bottom: 1px solid #f1f5f9;
      display: block;
      width: 100%;
    }

    /* Mobile Accordion Soluciones */
    .nav-dropdown {
      display: block;
