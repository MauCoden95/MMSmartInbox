---
// src/components/Header.astro
---
<div class="header-wrapper" id="header-wrapper">
  <header class="header">
    <a href="/" class="logo">
      <img src="/images/Logo.png" alt="MM SmartInbox" />
    </a>
    <nav class="nav" id="nav-menu">
      <a href="/#inicio">Inicio</a>
      <a href="/#soluciones">Soluciones</a>
      <a href="/#agente-ia">Agentes de IA</a>
      <a href="/#automatizaciones">Automatizaciones</a>
      <a href="/#casos-de-uso">Casos de uso</a>
      <a href="/#como-trabajamos">Cómo trabajamos</a>
      <a href="/#precios">Precios</a>
      <div class="mobile-cta">
        <button class="btn btn-navy" data-open-quote>Solicitar cotización</button>
      </div>
    </nav>
    <div class="actions">
      <button class="btn btn-navy" data-open-quote>Solicitar cotización</button>
    </div>
    <button class="mobile-toggle" id="mobile-toggle" aria-label="Abrir menú">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </header>
</div>

<script>
  const wrapper = document.getElementById('header-wrapper');
  const toggle = document.getElementById('mobile-toggle');
  const nav = document.getElementById('nav-menu');

  function updateShadow() {
    if (window.scrollY > 10) {
      wrapper?.classList.add('scrolled');
    } else {
      wrapper?.classList.remove('scrolled');
    }
  }
  window.addEventListener('scroll', updateShadow, { passive: true });
  updateShadow();

  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('active');
  });

  nav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      nav?.classList.remove('active');
    });
  });
</script>

<style>
  .header-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 0 0 0 transparent;
    transition: all 0.3s ease;
    border-bottom: 1px solid #f1f5f9;
  }
  .header-wrapper.scrolled {
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 0;
    max-width: 1280px;
    width: 92%;
    margin: 0 auto;
    font-family: 'Inter', sans-serif;
  }
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .logo img {
    height: 52px;
    width: auto;
    object-fit: contain;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }
  .nav a {
    text-decoration: none;
    color: #1e293b;
    font-weight: 600;
    font-size: 0.92rem;
    transition: color 0.2s ease;
    position: relative;
  }
  .nav a:hover {
    color: #0b2591;
  }
  .actions {
    display: flex;
    align-items: center;
  }
  .btn.btn-navy {
    background-color: #0b2591;
    color: white;
    padding: 0.65rem 1.4rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(11, 37, 145, 0.25);
    border: none;
    cursor: pointer;
    font-family: inherit;
    letter-spacing: -0.2px;
  }
  .btn.btn-navy:hover {
    background-color: #061868;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(11, 37, 145, 0.35);
  }
  
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: #0b2591;
    cursor: pointer;
    padding: 0.5rem;
  }
  
  .mobile-cta {
    display: none;
  }

  @media (max-width: 1180px) and (min-width: 901px) {
    .header {
      padding: 0.8rem 0;
    }
    .logo img {
      height: 44px;
    }
    .nav {
      gap: 1.1rem;
    }
    .nav a {
      font-size: 0.84rem;
    }
    .btn.btn-navy {
      padding: 0.55rem 1rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 900px) {
    .actions {
      display: none;
    }
    .logo img {
      height: 44px;
    }
    .mobile-toggle {
      display: block;
    }
    .header {
      padding: 0.8rem 0;
    }
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: white;
      flex-direction: column;
      gap: 0;
      padding: 0;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
      clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
      transition: clip-path 0.3s ease-in-out;
    }
    .nav.active {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      border-top: 1px solid #f1f5f9;
    }
    .nav a:not(.btn) {
      padding: 1rem 1.8rem;
      border-bottom: 1px solid #f1f5f9;
      display: block;
      width: 100%;
    }
    .mobile-cta {
      display: block;
      padding: 1.2rem 1.8rem;
    }
    .mobile-cta .btn {
      display: block;
      width: 100%;
      text-align: center;
    }
  }
</style>
